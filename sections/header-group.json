      "settings": {
        "custom_liquid": "{% comment %}\n  ==========================================================\n  UN-FAIR — CUSTOM HEADER\n  Built for Shopify Colourblock\n  Paste directly inside: Theme Editor → Custom liquid\n\n  Palette:\n  Warm Ivory       #F5F0EC\n  Deep Charcoal    #1C1C1B\n  Muted Terracotta #B76B56\n  ==========================================================\n{% endcomment %}\n\n<style>\n  /* =========================\n     UN-FAIR HEADER VARIABLES\n  ========================== */\n  #unfair-header {\n    --uf-ivory: #F5F0EC;\n    --uf-charcoal: #1C1C1B;\n    --uf-accent: #B76B56;\n    --uf-border: rgba(28, 28, 27, 0.14);\n\n    position: relative;\n    z-index: 50;\n    width: 100%;\n    font-family: inherit;\n  }\n\n  #unfair-header *,\n  #unfair-header *::before,\n  #unfair-header *::after {\n    box-sizing: border-box;\n  }\n\n  #unfair-header a {\n    text-decoration: none;\n  }\n\n  /* =========================\n     ANNOUNCEMENT BAR\n  ========================== */\n  .uf-announcement {\n    width: 100%;\n    background: var(--uf-charcoal);\n    color: var(--uf-ivory);\n    min-height: 35px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    position: relative;\n  }\n\n  .uf-announcement-inner {\n    width: 100%;\n    position: relative;\n    height: 35px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .uf-announcement-item {\n    position: absolute;\n    width: 100%;\n    text-align: center;\n    padding: 0 45px;\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 600;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n\n    opacity: 0;\n    transform: translateY(7px);\n\n    transition:\n      opacity 0.45s ease,\n      transform 0.45s ease;\n  }\n\n  .uf-announcement-item.is-active {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .uf-announcement-accent {\n    color: var(--uf-accent);\n  }\n\n  /* =========================\n     MAIN HEADER\n  ========================== */\n  .uf-header-shell {\n    width: 100%;\n    background: rgba(245, 240, 236, 0.97);\n    border-bottom: 1px solid var(--uf-border);\n\n    transition:\n      background 0.3s ease,\n      box-shadow 0.3s ease,\n      transform 0.3s ease;\n  }\n\n  .uf-header-shell.is-sticky {\n    position: fixed;\n    top: 0;\n    left: 0;\n    right: 0;\n    z-index: 9999;\n\n    background: rgba(245, 240, 236, 0.96);\n    backdrop-filter: blur(14px);\n    -webkit-backdrop-filter: blur(14px);\n\n    box-shadow: 0 8px 30px rgba(28, 28, 27, 0.05);\n  }\n\n  .uf-header-placeholder {\n    display: none;\n  }\n\n  .uf-header-placeholder.is-active {\n    display: block;\n  }\n\n  .uf-header-inner {\n    width: 100%;\n    max-width: 1600px;\n    margin: 0 auto;\n\n    min-height: 82px;\n\n    display: grid;\n    grid-template-columns: 1fr auto 1fr;\n    align-items: center;\n\n    padding: 0 42px;\n  }\n\n  /* =========================\n     DESKTOP NAV\n  ========================== */\n  .uf-nav-left,\n  .uf-nav-right {\n    display: flex;\n    align-items: center;\n    gap: 30px;\n  }\n\n  .uf-nav-left {\n    justify-content: flex-start;\n  }\n\n  .uf-nav-right {\n    justify-content: flex-end;\n  }\n\n  .uf-nav-link {\n    color: var(--uf-charcoal);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 600;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    position: relative;\n    padding: 12px 0;\n\n    transition: color 0.25s ease;\n  }\n\n  .uf-nav-link::after {\n    content: \"\";\n    position: absolute;\n    bottom: 5px;\n    left: 0;\n\n    width: 100%;\n    height: 1px;\n\n    background: var(--uf-accent);\n\n    transform: scaleX(0);\n    transform-origin: right;\n\n    transition: transform 0.3s ease;\n  }\n\n  .uf-nav-link:hover {\n    color: var(--uf-accent);\n  }\n\n  .uf-nav-link:hover::after {\n    transform: scaleX(1);\n    transform-origin: left;\n  }\n\n  /* =========================\n     LOGO\n  ========================== */\n  .uf-logo {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    color: var(--uf-charcoal);\n\n    font-size: 29px;\n    line-height: 1;\n    font-weight: 800;\n    letter-spacing: -0.06em;\n\n    white-space: nowrap;\n\n    transition: color 0.25s ease;\n  }\n\n  .uf-logo:hover {\n    color: var(--uf-accent);\n  }\n\n  .uf-logo-mark {\n    position: relative;\n  }\n\n  .uf-logo-mark::after {\n    content: \"\";\n    position: absolute;\n    width: 5px;\n    height: 5px;\n\n    background: var(--uf-accent);\n    border-radius: 50%;\n\n    right: -9px;\n    top: 1px;\n  }\n\n  /* =========================\n     ICON BUTTONS\n  ========================== */\n  .uf-icon-btn {\n    appearance: none;\n    border: 0;\n    padding: 8px;\n    margin: 0;\n\n    background: transparent;\n    color: var(--uf-charcoal);\n\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    cursor: pointer;\n\n    transition:\n      color 0.25s ease,\n      transform 0.25s ease;\n  }\n\n  .uf-icon-btn:hover {\n    color: var(--uf-accent);\n  }\n\n  .uf-icon-btn svg {\n    width: 20px;\n    height: 20px;\n    stroke: currentColor;\n  }\n\n  .uf-cart-link {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n\n    color: var(--uf-charcoal);\n\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n\n    transition: color 0.25s ease;\n  }\n\n  .uf-cart-link:hover {\n    color: var(--uf-accent);\n  }\n\n  .uf-cart-count {\n    min-width: 20px;\n    height: 20px;\n\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    background: var(--uf-charcoal);\n    color: var(--uf-ivory);\n\n    border-radius: 50%;\n\n    font-size: 9px;\n    letter-spacing: 0;\n\n    transition:\n      background 0.25s ease,\n      color 0.25s ease;\n  }\n\n  .uf-cart-link:hover .uf-cart-count {\n    background: var(--uf-accent);\n  }\n\n  /* =========================\n     MOBILE HEADER\n  ========================== */\n  .uf-mobile-left,\n  .uf-mobile-right {\n    display: none;\n  }\n\n  /* =========================\n     MOBILE DRAWER\n  ========================== */\n  .uf-drawer-overlay {\n    position: fixed;\n    inset: 0;\n    z-index: 10000;\n\n    background: rgba(28, 28, 27, 0.32);\n\n    opacity: 0;\n    visibility: hidden;\n\n    transition:\n      opacity 0.35s ease,\n      visibility 0.35s ease;\n  }\n\n  .uf-drawer-overlay.is-open {\n    opacity: 1;\n    visibility: visible;\n  }\n\n  .uf-drawer {\n    position: fixed;\n\n    top: 0;\n    left: 0;\n\n    width: min(88vw, 420px);\n    height: 100dvh;\n\n    z-index: 10001;\n\n    background: var(--uf-ivory);\n    color: var(--uf-charcoal);\n\n    transform: translateX(-105%);\n\n    transition: transform 0.42s cubic-bezier(.22,.61,.36,1);\n\n    display: flex;\n    flex-direction: column;\n  }\n\n  .uf-drawer.is-open {\n    transform: translateX(0);\n  }\n\n  .uf-drawer-top {\n    height: 78px;\n\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n\n    padding: 0 24px;\n\n    border-bottom: 1px solid var(--uf-border);\n  }\n\n  .uf-drawer-logo {\n    color: var(--uf-charcoal);\n\n    font-size: 24px;\n    line-height: 1;\n    font-weight: 800;\n    letter-spacing: -0.06em;\n  }\n\n  .uf-drawer-close {\n    appearance: none;\n    border: 0;\n    background: transparent;\n\n    color: var(--uf-charcoal);\n\n    width: 42px;\n    height: 42px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    cursor: pointer;\n  }\n\n  .uf-drawer-close svg {\n    width: 22px;\n    height: 22px;\n    stroke: currentColor;\n  }\n\n  .uf-drawer-nav {\n    padding: 38px 24px 30px;\n  }\n\n  .uf-drawer-nav a {\n    color: var(--uf-charcoal);\n\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n\n    padding: 16px 0;\n\n    border-bottom: 1px solid var(--uf-border);\n\n    font-size: clamp(24px, 7vw, 34px);\n    line-height: 1;\n    font-weight: 500;\n    letter-spacing: -0.04em;\n\n    transition:\n      color 0.25s ease,\n      padding-left 0.25s ease;\n  }\n\n  .uf-drawer-nav a:hover {\n    color: var(--uf-accent);\n    padding-left: 7px;\n  }\n\n  .uf-drawer-arrow {\n    color: var(--uf-accent);\n\n    font-size: 18px;\n    font-weight: 400;\n  }\n\n  .uf-drawer-bottom {\n    margin-top: auto;\n\n    padding: 25px 24px 30px;\n\n    background: var(--uf-charcoal);\n    color: var(--uf-ivory);\n  }\n\n  .uf-drawer-eyebrow {\n    margin: 0 0 10px;\n\n    color: var(--uf-accent);\n\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n  }\n\n  .uf-drawer-message {\n    margin: 0;\n\n    max-width: 280px;\n\n    font-size: 21px;\n    line-height: 1.15;\n    letter-spacing: -0.035em;\n  }\n\n  /* =========================\n     SEARCH OVERLAY\n  ========================== */\n  .uf-search-overlay {\n    position: fixed;\n    inset: 0;\n\n    z-index: 10010;\n\n    background: var(--uf-ivory);\n\n    opacity: 0;\n    visibility: hidden;\n\n    transition:\n      opacity 0.3s ease,\n      visibility 0.3s ease;\n  }\n\n  .uf-search-overlay.is-open {\n    opacity: 1;\n    visibility: visible;\n  }\n\n  .uf-search-top {\n    min-height: 80px;\n\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n\n    padding: 0 42px;\n\n    border-bottom: 1px solid var(--uf-border);\n  }\n\n  .uf-search-title {\n    margin: 0;\n\n    color: var(--uf-charcoal);\n\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n  }\n\n  .uf-search-close {\n    appearance: none;\n    border: 0;\n    background: transparent;\n\n    color: var(--uf-charcoal);\n\n    cursor: pointer;\n\n    width: 42px;\n    height: 42px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .uf-search-close svg {\n    width: 23px;\n    height: 23px;\n    stroke: currentColor;\n  }\n\n  .uf-search-content {\n    max-width: 1100px;\n    margin: 0 auto;\n\n    padding: 10vh 42px;\n  }\n\n  .uf-search-label {\n    display: block;\n\n    margin-bottom: 18px;\n\n    color: var(--uf-accent);\n\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n  }\n\n  .uf-search-form {\n    display: flex;\n    align-items: center;\n\n    border-bottom: 2px solid var(--uf-charcoal);\n  }\n\n  .uf-search-input {\n    flex: 1;\n\n    appearance: none;\n    border: 0;\n    outline: none;\n\n    padding: 15px 0 20px;\n\n    background: transparent;\n    color: var(--uf-charcoal);\n\n    font-family: inherit;\n    font-size: clamp(30px, 5vw, 65px);\n    line-height: 1;\n    letter-spacing: -0.05em;\n  }\n\n  .uf-search-input::placeholder {\n    color: rgba(28, 28, 27, 0.27);\n  }\n\n  .uf-search-submit {\n    appearance: none;\n    border: 0;\n    background: transparent;\n\n    color: var(--uf-charcoal);\n\n    cursor: pointer;\n\n    padding: 15px;\n\n    transition: color 0.25s ease;\n  }\n\n  .uf-search-submit:hover {\n    color: var(--uf-accent);\n  }\n\n  .uf-search-submit svg {\n    width: 30px;\n    height: 30px;\n    stroke: currentColor;\n  }\n\n  .uf-search-hint {\n    margin: 18px 0 0;\n\n    color: rgba(28, 28, 27, 0.55);\n\n    font-size: 11px;\n    letter-spacing: 0.04em;\n  }\n\n  /* =========================\n     RESPONSIVE\n  ========================== */\n  @media screen and (max-width: 989px) {\n\n    .uf-header-inner {\n      min-height: 68px;\n\n      grid-template-columns: 1fr auto 1fr;\n\n      padding: 0 16px;\n    }\n\n    .uf-nav-left,\n    .uf-nav-right {\n      display: none;\n    }\n\n    .uf-mobile-left,\n    .uf-mobile-right {\n      display: flex;\n      align-items: center;\n    }\n\n    .uf-mobile-left {\n      justify-content: flex-start;\n    }\n\n    .uf-mobile-right {\n      justify-content: flex-end;\n      gap: 2px;\n    }\n\n    .uf-logo {\n      font-size: 24px;\n    }\n\n    .uf-logo-mark::after {\n      width: 4px;\n      height: 4px;\n      right: -7px;\n    }\n\n    .uf-mobile-cart {\n      position: relative;\n    }\n\n    .uf-mobile-cart-count {\n      position: absolute;\n\n      top: 0;\n      right: 0;\n\n      width: 15px;\n      height: 15px;\n\n      border-radius: 50%;\n\n      display: flex;\n      align-items: center;\n      justify-content: center;\n\n      background: var(--uf-accent);\n      color: #fff;\n\n      font-size: 8px;\n      font-weight: 700;\n    }\n\n    .uf-announcement {\n      min-height: 32px;\n    }\n\n    .uf-announcement-inner {\n      height: 32px;\n    }\n\n    .uf-announcement-item {\n      font-size: 8.5px;\n      letter-spacing: 0.13em;\n      padding: 0 18px;\n    }\n\n    .uf-search-top {\n      min-height: 68px;\n      padding: 0 18px;\n    }\n\n    .uf-search-content {\n      padding: 9vh 20px;\n    }\n\n    .uf-search-input {\n      font-size: 34px;\n    }\n\n    .uf-search-submit svg {\n      width: 25px;\n      height: 25px;\n    }\n  }\n\n  @media screen and (max-width: 390px) {\n    .uf-header-inner {\n      padding: 0 12px;\n    }\n\n    .uf-logo {\n      font-size: 22px;\n    }\n\n    .uf-icon-btn {\n      padding: 7px;\n    }\n\n    .uf-icon-btn svg {\n      width: 19px;\n      height: 19px;\n    }\n  }\n\n  /* Prevent body scroll */\n  body.uf-no-scroll {\n    overflow: hidden;\n  }\n</style>\n\n\n<div id=\"unfair-header\">\n\n  <!-- ==========================================\n       ANNOUNCEMENT BAR\n  =========================================== -->\n  <div class=\"uf-announcement\">\n    <div class=\"uf-announcement-inner\">\n\n      <div class=\"uf-announcement-item is-active\">\n        LOOK BETTER THAN THE\n        <span class=\"uf-announcement-accent\">EFFORT YOU PUT IN.</span>\n      </div>",
