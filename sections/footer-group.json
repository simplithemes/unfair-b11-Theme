      "settings": {
        "custom_liquid": "{% comment %}\nUN-FAIR — CUSTOM FOOTER\nShopify Colourblock — Custom Liquid\n\nThis is designed to replace the visual footer area.\nIf you use it as your footer, hide Colourblock's default footer section.\n\nLinks used:\nShop            /collections/all\nAbout           /pages/about-us\nContact         /pages/contact\nSearch          /search\nPrivacy         /policies/privacy-policy\nTerms           /policies/terms-of-service\nRefund          /policies/refund-policy\nShipping        /policies/shipping-policy\n\nUpdate Instagram URL when the final handle is available.\n{% endcomment %}\n\n<style>\n#uf-footer{\n  --ivory:#F5F0EC;\n  --charcoal:#1C1C1B;\n  --terra:#B76B56;\n  --line:rgba(245,240,236,.17);\n\n  width:100%;\n  margin:0;\n  padding:0;\n\n  background:#1C1C1B !important;\n  color:#F5F0EC !important;\n\n  overflow:hidden;\n  font-family:inherit;\n}\n\n#uf-footer *,\n#uf-footer *::before,\n#uf-footer *::after{\n  box-sizing:border-box;\n}\n\n#uf-footer h2,\n#uf-footer h3,\n#uf-footer p,\n#uf-footer span,\n#uf-footer div,\n#uf-footer label{\n  color:inherit;\n}\n\n#uf-footer a,\n#uf-footer a:visited{\n  color:#F5F0EC !important;\n  text-decoration:none;\n}\n\n\n/* ========================================================\n   NEWSLETTER\n======================================================== */\n\n.ufft-newsletter{\n  max-width:1600px;\n  margin:0 auto;\n\n  padding:\n    clamp(75px,9vw,135px)\n    clamp(20px,4vw,64px)\n    clamp(70px,8vw,115px);\n\n  display:grid;\n  grid-template-columns:minmax(0,1.1fr) minmax(320px,.9fr);\n  gap:clamp(50px,8vw,130px);\n\n  border-bottom:1px solid var(--line);\n}\n\n.ufft-kicker{\n  display:flex;\n  align-items:center;\n  gap:12px;\n\n  margin:0 0 27px;\n\n  color:#B76B56 !important;\n\n  font-size:9px;\n  line-height:1;\n  font-weight:700;\n\n  letter-spacing:.2em;\n  text-transform:uppercase;\n}\n\n.ufft-kicker-dot{\n  width:7px;\n  height:7px;\n\n  border-radius:50%;\n\n  background:#B76B56;\n}\n\n.ufft-title{\n  max-width:850px;\n\n  margin:0 !important;\n\n  color:#F5F0EC !important;\n\n  font-family:inherit;\n\n  font-size:clamp(51px,6.5vw,102px);\n  line-height:.87;\n\n  font-weight:500;\n\n  letter-spacing:-.07em;\n\n  text-transform:uppercase;\n}\n\n.ufft-title em{\n  color:#B76B56 !important;\n\n  font-weight:inherit;\n}\n\n.ufft-news-right{\n  display:flex;\n  flex-direction:column;\n  justify-content:flex-end;\n}\n\n.ufft-news-copy{\n  max-width:430px;\n\n  margin:0 0 30px;\n\n  color:rgba(245,240,236,.66) !important;\n\n  font-size:13px;\n  line-height:1.65;\n}\n\n\n/* ========================================================\n   SHOPIFY CUSTOMER FORM\n======================================================== */\n\n.ufft-form{\n  width:100%;\n}\n\n.ufft-field{\n  display:grid;\n  grid-template-columns:minmax(0,1fr) auto;\n\n  border-bottom:1px solid rgba(245,240,236,.55);\n}\n\n.ufft-input{\n  width:100%;\n\n  appearance:none;\n  -webkit-appearance:none;\n\n  border:0 !important;\n  outline:0 !important;\n  box-shadow:none !important;\n\n  padding:18px 0;\n\n  background:transparent !important;\n  color:#F5F0EC !important;\n\n  font-family:inherit;\n\n  font-size:16px;\n  line-height:1.2;\n}\n\n.ufft-input::placeholder{\n  color:rgba(245,240,236,.38) !important;\n}\n\n.ufft-submit{\n  appearance:none;\n  -webkit-appearance:none;\n\n  border:0 !important;\n  outline:0;\n\n  padding:0 0 0 25px;\n\n  background:transparent !important;\n  color:#B76B56 !important;\n\n  cursor:pointer;\n\n  font-family:inherit;\n\n  font-size:10px;\n  font-weight:700;\n\n  letter-spacing:.16em;\n\n  text-transform:uppercase;\n}\n\n.ufft-submit:hover{\n  color:#F5F0EC !important;\n}\n\n.ufft-form-message{\n  margin:13px 0 0;\n\n  color:rgba(245,240,236,.65) !important;\n\n  font-size:10px;\n  line-height:1.5;\n}\n\n.ufft-form-message--success{\n  color:#B76B56 !important;\n}\n\n\n/* ========================================================\n   FOOTER NAVIGATION\n======================================================== */\n\n.ufft-nav-wrap{\n  max-width:1600px;\n  margin:0 auto;\n\n  padding:\n    clamp(55px,6vw,85px)\n    clamp(20px,4vw,64px);\n\n  display:grid;\n  grid-template-columns:1.5fr repeat(3,1fr);\n\n  gap:55px;\n\n  border-bottom:1px solid var(--line);\n}\n\n\n/* BRAND COLUMN */\n\n.ufft-brand{\n  padding-right:30px;\n}\n\n.ufft-logo{\n  margin:0;\n\n  color:#F5F0EC !important;\n\n  font-size:clamp(35px,4vw,60px);\n  line-height:.9;\n\n  font-weight:800;\n\n  letter-spacing:-.065em;\n}\n\n.ufft-brand-copy{\n  max-width:300px;\n\n  margin:23px 0 0;\n\n  color:rgba(245,240,236,.55) !important;\n\n  font-size:11px;\n  line-height:1.65;\n}\n\n.ufft-brand-line{\n  margin:27px 0 0;\n\n  color:#B76B56 !important;\n\n  font-size:8px;\n  line-height:1.5;\n\n  font-weight:700;\n\n  letter-spacing:.17em;\n\n  text-transform:uppercase;\n}\n\n\n/* LINK COLUMNS */\n\n.ufft-column-title{\n  margin:0 0 24px;\n\n  color:#B76B56 !important;\n\n  font-size:8px;\n  line-height:1;\n\n  font-weight:700;\n\n  letter-spacing:.19em;\n\n  text-transform:uppercase;\n}\n\n.ufft-links{\n  display:flex;\n  flex-direction:column;\n\n  gap:13px;\n}\n\n#uf-footer .ufft-link{\n  position:relative;\n\n  width:max-content;\n  max-width:100%;\n\n  color:#F5F0EC !important;\n\n  font-size:11px;\n  line-height:1.4;\n\n  font-weight:500;\n\n  letter-spacing:.01em;\n}\n\n#uf-footer .ufft-link::after{\n  content:\"\";\n\n  position:absolute;\n\n  left:0;\n  bottom:-3px;\n\n  width:100%;\n  height:1px;\n\n  background:#B76B56;\n\n  transform:scaleX(0);\n  transform-origin:right;\n\n  transition:transform .28s ease;\n}\n\n#uf-footer .ufft-link:hover::after{\n  transform:scaleX(1);\n  transform-origin:left;\n}\n\n\n/* ========================================================\n   HUGE BRAND WORDMARK\n======================================================== */\n\n.ufft-wordmark{\n  max-width:1600px;\n\n  margin:0 auto;\n\n  padding:\n    clamp(40px,5vw,70px)\n    clamp(18px,4vw,64px)\n    clamp(25px,3vw,45px);\n\n  overflow:hidden;\n}\n\n.ufft-wordmark-text{\n  margin:0;\n\n  color:#F5F0EC !important;\n\n  font-size:clamp(90px,17.1vw,275px);\n  line-height:.73;\n\n  font-weight:800;\n\n  letter-spacing:-.085em;\n\n  text-transform:uppercase;\n\n  white-space:nowrap;\n}\n\n\n/* ========================================================\n   BOTTOM BAR\n======================================================== */\n\n.ufft-bottom{\n  max-width:1600px;\n\n  margin:0 auto;\n\n  padding:\n    25px\n    clamp(20px,4vw,64px)\n    32px;\n\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n\n  gap:30px;\n\n  border-top:1px solid var(--line);\n}\n\n.ufft-copyright{\n  margin:0;\n\n  color:rgba(245,240,236,.42) !important;\n\n  font-size:8px;\n  line-height:1.5;\n\n  font-weight:700;\n\n  letter-spacing:.14em;\n\n  text-transform:uppercase;\n}\n\n.ufft-bottom-right{\n  display:flex;\n  align-items:center;\n\n  gap:20px;\n}\n\n#uf-footer .ufft-small-link{\n  color:rgba(245,240,236,.55) !important;\n\n  font-size:8px;\n  line-height:1;\n\n  font-weight:700;\n\n  letter-spacing:.13em;\n\n  text-transform:uppercase;\n\n  transition:color .25s ease;\n}\n\n#uf-footer .ufft-small-link:hover{\n  color:#B76B56 !important;\n}\n\n\n/* ========================================================\n   TABLET\n======================================================== */\n\n@media screen and (max-width:989px){\n\n  .ufft-newsletter{\n    grid-template-columns:1fr;\n\n    gap:45px;\n  }\n\n  .ufft-news-copy{\n    max-width:500px;\n  }\n\n  .ufft-nav-wrap{\n    grid-template-columns:1.3fr 1fr 1fr;\n\n    gap:45px;\n  }\n\n  .ufft-brand{\n    grid-column:1 / -1;\n\n    padding-right:0;\n    padding-bottom:15px;\n  }\n\n}\n\n\n/* ========================================================\n   MOBILE\n======================================================== */\n\n@media screen and (max-width:749px){\n\n  .ufft-newsletter{\n    padding:\n      70px 20px\n      65px;\n\n    gap:38px;\n  }\n\n  .ufft-kicker{\n    margin-bottom:22px;\n\n    font-size:8px;\n  }\n\n  .ufft-title{\n    font-size:\n      clamp(48px,14.8vw,70px);\n\n    line-height:.89;\n  }\n\n  .ufft-news-copy{\n    max-width:335px;\n\n    font-size:12px;\n    line-height:1.58;\n  }\n\n  .ufft-input{\n    font-size:14px;\n  }\n\n  .ufft-submit{\n    padding-left:15px;\n\n    font-size:8px;\n  }\n\n\n  /* NAV */\n\n  .ufft-nav-wrap{\n    padding:\n      50px 20px;\n\n    grid-template-columns:1fr 1fr;\n\n    gap:45px 25px;\n  }\n\n  .ufft-brand{\n    grid-column:1 / -1;\n\n    padding-bottom:10px;\n  }\n\n  .ufft-logo{\n    font-size:44px;\n  }\n\n  .ufft-brand-copy{\n    max-width:290px;\n  }\n\n\n  /* WORDMARK */\n\n  .ufft-wordmark{\n    padding:\n      38px 10px\n      24px;\n  }\n\n  .ufft-wordmark-text{\n    font-size:28vw;\n\n    line-height:.76;\n\n    letter-spacing:-.09em;\n  }\n\n\n  /* BOTTOM */\n\n  .ufft-bottom{\n    padding:\n      23px 20px\n      28px;\n\n    flex-direction:column;\n    align-items:flex-start;\n\n    gap:18px;\n  }\n\n  .ufft-bottom-right{\n    flex-wrap:wrap;\n\n    gap:13px 18px;\n  }\n\n}\n\n</style>\n\n\n<footer id=\"uf-footer\">\n\n\n  <!-- =====================================================\n       NEWSLETTER\n  ====================================================== -->\n\n  <div class=\"ufft-newsletter\">\n\n\n    <div>\n\n      <div class=\"ufft-kicker\">\n\n        <span class=\"ufft-kicker-dot\"></span>\n\n        STAY UN-FAIR\n\n      </div>\n\n\n      <h2 class=\"ufft-title\">\n\n        WANT AN\n        <br>\n\n        <em>UNFAIR</em>\n        <br>\n\n        ADVANTAGE?\n\n      </h2>\n\n    </div>\n\n\n\n    <div class=\"ufft-news-right\">\n\n      <p class=\"ufft-news-copy\">\n\n        New drops, smarter shortcuts and beauty that does more\n        of the work for you. Your inbox can handle it.\n\n      </p>\n\n\n      {% form 'customer', class: 'ufft-form' %}\n\n        <input\n          type=\"hidden\"\n          name=\"contact[tags]\"\n          value=\"newsletter\"\n        >\n\n\n        <div class=\"ufft-field\">\n\n          <input\n            class=\"ufft-input\"\n            type=\"email\"\n            name=\"contact[email]\"\n            value=\"{% if customer %}{{ customer.email }}{% endif %}\"\n            placeholder=\"Your email address\"\n            autocorrect=\"off\"\n            autocapitalize=\"off\"\n            autocomplete=\"email\"\n            required\n            aria-label=\"Email address\"\n          >\n\n\n          <button\n            class=\"ufft-submit\"\n            type=\"submit\"\n          >\n            I'M IN →\n          </button>\n\n        </div>\n\n\n        {% if form.posted_successfully? %}\n\n          <p class=\"ufft-form-message ufft-form-message--success\">\n            You're in. Advantage incoming.\n          </p>\n\n        {% endif %}\n\n\n        {% if form.errors %}\n\n          <div class=\"ufft-form-message\">\n            {{ form.errors | default_errors }}\n          </div>\n\n        {% endif %}\n\n\n      {% endform %}\n\n    </div>\n\n\n  </div>\n\n\n\n  <!-- =====================================================\n       NAVIGATION\n  ====================================================== -->\n\n  <div class=\"ufft-nav-wrap\">\n\n\n    <!-- BRAND -->\n\n    <div class=\"ufft-brand\">\n\n      <h3 class=\"ufft-logo\">\n        UN-FAIR\n      </h3>\n\n\n      <p class=\"ufft-brand-copy\">\n\n        Beauty for an unfair visual advantage.\n        Instant uplift. Long-term edge.\n        More results, less effort.\n\n      </p>\n\n\n      <p class=\"ufft-brand-line\">\n        LOOK BETTER THAN THE EFFORT YOU PUT IN.\n      </p>\n\n    </div>\n\n\n\n    <!-- SHOP -->\n\n    <div>\n\n      <p class=\"ufft-column-title\">\n        SHOP\n      </p>\n\n\n      <nav class=\"ufft-links\" aria-label=\"Shop\">\n\n        <a class=\"ufft-link\" href=\"/collections/all\">\n          Shop All\n        </a>\n\n        <a class=\"ufft-link\" href=\"/collections/all\">\n          Bestsellers\n        </a>\n\n        <a class=\"ufft-link\" href=\"/collections/all\">\n          Skin\n        </a>\n\n        <a class=\"ufft-link\" href=\"/collections/all\">\n          Hair\n        </a>\n\n        <a class=\"ufft-link\" href=\"/collections/all\">\n          New Drops\n        </a>\n\n      </nav>\n\n    </div>\n\n\n\n    <!-- ABOUT -->\n\n    <div>\n\n      <p class=\"ufft-column-title\">\n        UN-FAIR\n      </p>\n\n\n      <nav class=\"ufft-links\" aria-label=\"About UN-FAIR\">\n\n        <a class=\"ufft-link\" href=\"/pages/about-us\">\n          Why UN-FAIR?\n        </a>\n\n        <a class=\"ufft-link\" href=\"/pages/about-us\">\n          The UN-FAIR Edge\n        </a>\n\n        <a class=\"ufft-link\" href=\"/pages/contact\">\n          Contact\n        </a>\n\n        <a class=\"ufft-link\" href=\"/search\">\n          Search\n        </a>\n\n      </nav>\n\n    </div>\n\n\n\n    <!-- HELP -->\n\n    <div>\n\n      <p class=\"ufft-column-title\">\n        THE BORING STUFF\n      </p>\n\n\n      <nav class=\"ufft-links\" aria-label=\"Customer policies\">\n\n        <a class=\"ufft-link\" href=\"/policies/shipping-policy\">\n          Shipping\n        </a>\n\n        <a class=\"ufft-link\" href=\"/policies/refund-policy\">\n          Returns & Refunds\n        </a>\n\n        <a class=\"ufft-link\" href=\"/policies/privacy-policy\">\n          Privacy\n        </a>\n\n        <a class=\"ufft-link\" href=\"/policies/terms-of-service\">\n          Terms\n        </a>\n\n      </nav>\n\n    </div>\n\n\n  </div>\n\n\n\n  <!-- =====================================================\n       GIANT WORDMARK\n  ====================================================== -->\n\n  <div class=\"ufft-wordmark\">\n\n    <div class=\"ufft-wordmark-text\">\n      UN-FAIR\n    </div>\n\n  </div>\n\n\n\n  <!-- =====================================================\n       BOTTOM BAR\n  ====================================================== -->\n\n  <div class=\"ufft-bottom\">\n\n\n    <p class=\"ufft-copyright\">\n\n      © {{ 'now' | date: '%Y' }} UN-FAIR.\n      ALL RIGHTS RESERVED.\n\n    </p>\n\n\n    <div class=\"ufft-bottom-right\">\n\n      <a\n        class=\"ufft-small-link\"\n        href=\"/policies/privacy-policy\"\n      >\n        PRIVACY\n      </a>\n\n\n      <a\n        class=\"ufft-small-link\"\n        href=\"/policies/terms-of-service\"\n      >\n        TERMS\n      </a>\n\n\n      <a\n        class=\"ufft-small-link\"\n        href=\"/pages/contact\"\n      >\n        CONTACT\n      </a>\n\n    </div>\n\n\n  </div>\n\n\n</footer>",
