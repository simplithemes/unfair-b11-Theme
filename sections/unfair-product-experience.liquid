{% if product != blank %}
{% assign current_variant = product.selected_or_first_available_variant %}
<section id="unfair-foxtale-{{ section.id }}" class="uf-pdp">
<style>
#unfair-foxtale-{{ section.id }}{--ink:#26201f;--accent:#b56d58;--paper:#fffaf5;--line:#eaded7;color:var(--ink);background:var(--paper);font-family:inherit}
#unfair-foxtale-{{ section.id }} *{box-sizing:border-box}
#unfair-foxtale-{{ section.id }} .uf-wrap{max-width:1360px;margin:auto;padding:30px 28px 72px}
#unfair-foxtale-{{ section.id }} .uf-grid{display:grid;grid-template-columns:minmax(0,1.04fr) minmax(0,.96fr);gap:clamp(28px,5vw,76px)}
#unfair-foxtale-{{ section.id }} .uf-gallery{min-width:0}
#unfair-foxtale-{{ section.id }} .uf-stage{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;border-radius:22px;background:#eee3db}
#unfair-foxtale-{{ section.id }} .uf-stage::-webkit-scrollbar{display:none}
#unfair-foxtale-{{ section.id }} .uf-slide{flex:0 0 100%;aspect-ratio:1/1.13;scroll-snap-align:start;position:relative}
#unfair-foxtale-{{ section.id }} .uf-slide img,#unfair-foxtale-{{ section.id }} .uf-slide video{width:100%;height:100%;object-fit:cover;display:block}
#unfair-foxtale-{{ section.id }} .uf-thumbs{display:flex;gap:10px;overflow-x:auto;margin-top:14px}
#unfair-foxtale-{{ section.id }} .uf-thumb{flex:0 0 76px;height:82px;border:2px solid transparent;border-radius:10px;overflow:hidden;padding:0;background:#eee;cursor:pointer}
#unfair-foxtale-{{ section.id }} .uf-thumb[aria-current=true]{border-color:var(--accent)}
#unfair-foxtale-{{ section.id }} .uf-thumb img{width:100%;height:100%;object-fit:cover}
#unfair-foxtale-{{ section.id }} .uf-info{padding-top:8px}
#unfair-foxtale-{{ section.id }} .uf-kicker{font-size:12px;letter-spacing:.17em;font-weight:700;color:var(--accent);text-transform:uppercase}
#unfair-foxtale-{{ section.id }} h1{font-size:clamp(30px,3.3vw,51px);line-height:1.08;letter-spacing:-.035em;margin:13px 0 12px;color:var(--ink)}
#unfair-foxtale-{{ section.id }} .uf-sub{font-size:16px;line-height:1.6;color:#635854;margin:0 0 18px}
#unfair-foxtale-{{ section.id }} .uf-price{display:flex;align-items:baseline;flex-wrap:wrap;gap:12px;margin:18px 0}
#unfair-foxtale-{{ section.id }} .uf-price strong{font-size:29px}
#unfair-foxtale-{{ section.id }} .uf-compare{color:#928783;text-decoration:line-through;font-size:17px}
#unfair-foxtale-{{ section.id }} .uf-save{background:#f8e8df;color:#9d493b;padding:6px 9px;border-radius:5px;font-size:12px;font-weight:800}
#unfair-foxtale-{{ section.id }} .uf-divider{height:1px;background:var(--line);margin:22px 0}
#unfair-foxtale-{{ section.id }} .uf-label{display:block;font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;margin:0 0 12px}
#unfair-foxtale-{{ section.id }} .uf-options{display:flex;gap:9px;flex-wrap:wrap}
#unfair-foxtale-{{ section.id }} .uf-option{border:1px solid #d6c6be;border-radius:9px;background:#fff;padding:12px 16px;cursor:pointer;font:inherit;font-size:14px;color:var(--ink)}
#unfair-foxtale-{{ section.id }} .uf-option[aria-pressed=true]{border:2px solid var(--ink);padding:11px 15px;background:#fff4ed;font-weight:700}
#unfair-foxtale-{{ section.id }} .uf-benefits{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
#unfair-foxtale-{{ section.id }} .uf-benefit{background:#f5ece5;border:1px solid #efe0d6;border-radius:12px;padding:18px 10px;text-align:center;font-size:12px;line-height:1.4;font-weight:700}
#unfair-foxtale-{{ section.id }} .uf-benefit span{display:block;font-size:23px;margin-bottom:9px}
#unfair-foxtale-{{ section.id }} .uf-qty{display:flex;align-items:center;border:1px solid #d6c6be;border-radius:9px;overflow:hidden;height:54px}
#unfair-foxtale-{{ section.id }} .uf-qty button{width:42px;height:100%;background:transparent;border:0;cursor:pointer;font-size:22px}
#unfair-foxtale-{{ section.id }} .uf-qty input{width:37px;text-align:center;border:0;background:transparent;font-size:16px;color:var(--ink);appearance:textfield}
#unfair-foxtale-{{ section.id }} .uf-buyrow{display:flex;gap:10px;margin-top:20px}
#unfair-foxtale-{{ section.id }} .uf-atc,#unfair-foxtale-{{ section.id }} .uf-now{min-height:54px;border-radius:9px;border:1px solid var(--ink);font-weight:800;font-size:14px;letter-spacing:.04em;cursor:pointer}
#unfair-foxtale-{{ section.id }} .uf-atc{background:var(--ink);color:#fff;flex:1}
#unfair-foxtale-{{ section.id }} .uf-atc:disabled{opacity:.5;cursor:not-allowed}
#unfair-foxtale-{{ section.id }} .uf-now{background:transparent;color:var(--ink);width:100%;margin-top:10px}
#unfair-foxtale-{{ section.id }} .uf-status{font-size:12px;margin-top:12px;min-height:20px;color:#635854}
#unfair-foxtale-{{ section.id }} .uf-details{margin-top:65px}
#unfair-foxtale-{{ section.id }} .uf-details h2{font-size:clamp(26px,3vw,39px);margin-bottom:23px;color:var(--ink)}
#unfair-foxtale-{{ section.id }} .uf-accordion{border-top:1px solid var(--line)}
#unfair-foxtale-{{ section.id }} .uf-accordion:last-child{border-bottom:1px solid var(--line)}
#unfair-foxtale-{{ section.id }} .uf-accordion summary{list-style:none;cursor:pointer;font-weight:800;padding:20px 4px;display:flex;justify-content:space-between}
#unfair-foxtale-{{ section.id }} .uf-accordion summary:after{content:'+';font-size:20px}
#unfair-foxtale-{{ section.id }} .uf-accordion[open] summary:after{content:'−'}
#unfair-foxtale-{{ section.id }} .uf-accordion .uf-copy{padding:0 4px 20px;color:#625753;line-height:1.7}
#unfair-foxtale-{{ section.id }} .uf-copy p{margin:0 0 12px}
#unfair-foxtale-{{ section.id }} .uf-mobile{display:none}
@media(max-width:800px){#unfair-foxtale-{{ section.id }} .uf-wrap{padding:12px 15px 95px}#unfair-foxtale-{{ section.id }} .uf-grid{grid-template-columns:1fr;gap:23px}#unfair-foxtale-{{ section.id }} .uf-stage{border-radius:15px}#unfair-foxtale-{{ section.id }} .uf-slide{aspect-ratio:1/1.06}#unfair-foxtale-{{ section.id }} .uf-info{padding-top:0}#unfair-foxtale-{{ section.id }} .uf-benefits{gap:6px}#unfair-foxtale-{{ section.id }} .uf-benefit{padding:13px 5px}#unfair-foxtale-{{ section.id }} .uf-details{margin-top:45px}#unfair-foxtale-{{ section.id }} .uf-mobile{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:50;background:#fffaf5;padding:10px 15px;box-shadow:0 -4px 20px #0002;gap:12px;align-items:center}#unfair-foxtale-{{ section.id }} .uf-mobile .uf-atc{min-height:48px}#unfair-foxtale-{{ section.id }} .uf-mobile strong{font-size:16px;white-space:nowrap}}
</style>
<div class="uf-wrap">
<div class="uf-grid">
<div class="uf-gallery">
<div class="uf-stage" data-stage>
{% for media in product.media %}
<div class="uf-slide" id="uf-media-{{ section.id }}-{{ forloop.index0 }}">
{% if media.media_type == 'image' %}{{ media | image_url: width: 1300 | image_tag: loading: 'lazy', widths: '400, 650, 900, 1300', alt: media.alt }}
{% else %}{{ media | media_tag: image_size: '900x', controls: true }}{% endif %}
</div>
{% else %}
<div class="uf-slide">{{ 'product-1' | placeholder_svg_tag }}</div>
{% endfor %}
</div>
{% if product.media.size > 1 %}
<div class="uf-thumbs" aria-label="Product images">
{% for media in product.media %}
<button type="button" class="uf-thumb" data-slide="{{ forloop.index0 }}" aria-label="View media {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
{% if media.preview_image %}{{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt }}{% endif %}
</button>
{% endfor %}
</div>
{% endif %}
</div>
<div class="uf-info">
<div class="uf-kicker">{{ product.vendor | default: 'UN-FAIR' | escape }}</div>
<h1>{{ product.title | escape }}</h1>
{% if product.metafields.custom.subtitle.value != blank %}<p class="uf-sub">{{ product.metafields.custom.subtitle.value | escape }}</p>{% elsif product.description != blank %}<p class="uf-sub">{{ product.description | strip_html | truncate: 150 | escape }}</p>{% endif %}
<div class="uf-price"><strong data-price>{{ current_variant.price | money }}</strong><span class="uf-compare" data-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</span><span class="uf-save" data-save {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price }}% OFF{% endif %}</span></div>
<div class="uf-divider"></div>
{% unless product.has_only_default_variant %}
{% for option in product.options_with_values %}
<div class="uf-label">{{ option.name | escape }}</div>
<div class="uf-options" data-option-index="{{ forloop.index0 }}" style="margin-bottom:18px">
{% for value in option.values %}
<button type="button" class="uf-option" data-value="{{ value | escape }}" aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}">{{ value | escape }}</button>
{% endfor %}
</div>
{% endfor %}
{% endunless %}
<div class="uf-label">Helps with</div>
<div class="uf-benefits">
<div class="uf-benefit"><span>✦</span>{{ product.metafields.custom.benefit_1.value | default: 'Everyday confidence' | escape }}</div>
<div class="uf-benefit"><span>◈</span>{{ product.metafields.custom.benefit_2.value | default: 'Effortless routine' | escape }}</div>
<div class="uf-benefit"><span>✳</span>{{ product.metafields.custom.benefit_3.value | default: 'Feel-good care' | escape }}</div>
</div>
<div class="uf-divider"></div>
{% form 'product', product, id: 'uf-product-form-' | append: section.id %}
<input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
<div class="uf-label">Quantity</div>
<div class="uf-buyrow"><div class="uf-qty"><button type="button" data-minus aria-label="Decrease quantity">−</button><input type="number" min="1" name="quantity" value="1" aria-label="Quantity"><button type="button" data-plus aria-label="Increase quantity">+</button></div><button class="uf-atc" type="submit" data-add {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}ADD TO BAG{% else %}SOLD OUT{% endif %}</button></div>
<button class="uf-now" type="button" data-buy-now {% unless current_variant.available %}disabled{% endunless %}>BUY NOW</button>
<div class="uf-status" data-status aria-live="polite"></div>
{% endform %}
</div>
</div>
<div class="uf-details"><h2>All about the product</h2>
<details class="uf-accordion" open><summary>What makes it special</summary><div class="uf-copy rte">{{ product.description }}</div></details>
{% if product.metafields.custom.key_ingredients.value != blank %}<details class="uf-accordion"><summary>Key ingredients</summary><div class="uf-copy">{{ product.metafields.custom.key_ingredients.value | metafield_tag }}</div></details>{% endif %}
{% if product.metafields.custom.how_to_use.value != blank %}<details class="uf-accordion"><summary>How to use</summary><div class="uf-copy">{{ product.metafields.custom.how_to_use.value | metafield_tag }}</div></details>{% endif %}
{% if product.metafields.custom.full_ingredients.value != blank %}<details class="uf-accordion"><summary>Full ingredients</summary><div class="uf-copy">{{ product.metafields.custom.full_ingredients.value | metafield_tag }}</div></details>{% endif %}
</div>
</div>
<div class="uf-mobile"><strong data-mobile-price>{{ current_variant.price | money }}</strong><button class="uf-atc" type="button" data-mobile-add {% unless current_variant.available %}disabled{% endunless %}>ADD TO BAG</button></div>
<script type="application/json" data-variants>{{ product.variants | json }}</script>
<script>
(function(){
const root=document.getElementById('unfair-foxtale-{{ section.id }}');if(!root)return;
const variants=JSON.parse(root.querySelector('[data-variants]').textContent);
const id=root.querySelector('[data-variant-id]'),price=root.querySelector('[data-price]'),compare=root.querySelector('[data-compare]'),save=root.querySelector('[data-save]'),status=root.querySelector('[data-status]'),add=root.querySelector('[data-add]'),now=root.querySelector('[data-buy-now]'),mobile=root.querySelector('[data-mobile-add]'),mobilePrice=root.querySelector('[data-mobile-price]'),form=root.querySelector('form');
const moneyFormat={{ shop.money_format | json }};
function money(cents){const n=(cents/100).toFixed(2);return moneyFormat.replace(/\{\{\s*(amount(?:_no_decimals|_with_comma_separator|_no_decimals_with_comma_separator)?)\s*\}\}/g,(_,format)=>{let val=format.includes('no_decimals')?Math.round(cents/100).toString():n;if(format.includes('comma_separator'))val=val.replace('.',',');return val;});}
let selected=variants.find(v=>String(v.id)===id.value)||variants[0];
function update(){const choices=[...root.querySelectorAll('[data-option-index]')].map(group=>group.querySelector('[aria-pressed=true]')?.dataset.value);const found=variants.find(v=>v.options.every((value,i)=>value===choices[i]));if(!found){add.disabled=true;now.disabled=true;mobile.disabled=true;status.textContent='Combination unavailable';return;}selected=found;id.value=found.id;price.textContent=money(found.price);mobilePrice.textContent=money(found.price);compare.hidden=!(found.compare_at_price>found.price);save.hidden=compare.hidden;if(!compare.hidden){compare.textContent=money(found.compare_at_price);save.textContent=Math.round((found.compare_at_price-found.price)*100/found.compare_at_price)+'% OFF';}add.disabled=now.disabled=mobile.disabled=!found.available;add.textContent=found.available?'ADD TO BAG':'SOLD OUT';status.textContent=found.available?'':'Currently unavailable';const url=new URL(location.href);url.searchParams.set('variant',found.id);history.replaceState({},'',url);}
root.querySelectorAll('[data-option-index]').forEach(group=>group.querySelectorAll('button').forEach(button=>button.addEventListener('click',()=>{group.querySelectorAll('button').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));update();})));
root.querySelector('[data-minus]').addEventListener('click',()=>{const q=form.querySelector('[name=quantity]');q.value=Math.max(1,(parseInt(q.value,10)||1)-1);});
root.querySelector('[data-plus]').addEventListener('click',()=>{const q=form.querySelector('[name=quantity]');q.value=(parseInt(q.value,10)||1)+1;});
root.querySelectorAll('[data-thumb]').forEach(()=>{});
root.querySelectorAll('[data-slide]').forEach(btn=>btn.addEventListener('click',()=>{const stage=root.querySelector('[data-stage]');stage.scrollTo({left:stage.clientWidth*Number(btn.dataset.slide),behavior:'smooth'});root.querySelectorAll('[data-slide]').forEach(b=>b.setAttribute('aria-current',String(b===btn)));}));
root.querySelector('[data-mobile-add]').addEventListener('click',()=>add.click());
now.addEventListener('click',()=>{if(!selected?.available)return;const q=Math.max(1,parseInt(form.querySelector('[name=quantity]').value,10)||1);location.href='/cart/'+selected.id+':'+q+'?checkout';});
})();
</script>
</section>
{% endif %}
{% schema %}
{"name":"UN-FAIR Product Experience","settings":[],"presets":[{"name":"UN-FAIR Product Experience"}]}
{% endschema %}