eight:1.6}\n/* 12 */\n.up-faq{background:#F5F0EC!important;padding:clamp(70px,8vw,110px) clamp(20px,5vw,80px)}.up-faq-in{max-width:1100px;margin:auto}.up-faq details{border-top:1px solid var(--ln)}.up-faq details:last-child{border-bottom:1px solid var(--ln)}.up-faq summary{list-style:none;cursor:pointer;padding:22px 0;display:flex;justify-content:space-between;gap:20px;color:#1C1C1B!important;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.up-faq summary::-webkit-details-marker{display:none}.up-faq summary:after{content:'+';color:#B76B56;font-size:18px;font-weight:300}.up-faq details[open] summary:after{transform:rotate(45deg)}.up-faq-answer{max-width:760px;padding:0 0 25px;color:rgba(28,28,27,.62)!important;font-size:12px;line-height:1.7}\n/* 13 / RELATED */\n.up-complete{padding:clamp(70px,8vw,110px) clamp(20px,5vw,80px);border-top:1px solid var(--ln)}.up-complete-head{max-width:1500px;margin:auto;display:flex;justify-content:space-between;align-items:end;gap:50px}.up-complete-grid{max-width:1500px;margin:45px auto 0;display:grid;grid-template-columns:repeat(3,1fr);gap:3px;background:var(--ln)}.up-related{background:#F5F0EC!important}.up-related-img{aspect-ratio:4/5;overflow:hidden;background:#E8E1DC}.up-related-img img{width:100%;height:100%;object-fit:cover;display:block;transition:.5s}.up-related:hover img{transform:scale(1.03)}.up-related-info{padding:15px 14px 22px;display:flex;justify-content:space-between;gap:15px}.up-related-info h3{margin:0!important;font-size:12px;line-height:1.2;font-weight:600}.up-related-price{font-size:10px;font-weight:700;white-space:nowrap}\n/* 14 */\n.up-final{background:#B76B56!important;color:#F5F0EC!important;padding:clamp(75px,9vw,130px) 20px;text-align:center}.up-final small{color:#1C1C1B!important;font-size:8px;font-weight:700;letter-spacing:.2em;text-transform:uppercase}.up-final h2{max-width:1100px;margin:20px auto 0!important;color:#F5F0EC!important;font-size:clamp(47px,7vw,105px);line-height:.86;font-weight:500;letter-spacing:-.07em;text-transform:uppercase}.up-final h2 em{color:#1C1C1B!important;font-weight:inherit}.up-final a{display:inline-flex;margin-top:35px;padding:16px 25px;background:#1C1C1B!important;color:#F5F0EC!important;font-size:8px;font-weight:700;letter-spacing:.15em;text-transform:uppercase}\n@media(max-width:989px){.up-main{grid-template-columns:1fr}.up-info{border-left:0}.up-stick{position:static}.up-diff-head,.up-inside-head,.up-complete-head{display:block}.up-diff-copy,.up-inside-copy{margin-top:25px}.up-why{grid-template-columns:1fr}.up-gallery-wrap{grid-template-columns:78px minmax(0,1fr)}.up-thumb{flex-basis:94px}}\n@media(max-width:749px){.up-gallery-wrap{display:flex;flex-direction:column;padding:0;gap:6px;background:#F5F0EC}.up-slider-shell{order:1}.up-thumbs{order:2;flex-direction:row;overflow-x:auto;overflow-y:hidden;max-height:none;padding:0 12px 4px;gap:6px}.up-thumb{flex:0 0 66px;width:66px;height:82px}.up-slide{aspect-ratio:4/5;min-height:560px}.up-gallery-arrow{width:38px;height:38px}.up-prev{left:10px}.up-next{right:10px}.up-gallery-count{right:10px;bottom:10px}.up-info{padding:48px 18px 55px}.up-title{font-size:clamp(42px,12vw,58px)}.up-points{grid-template-columns:1fr}.up-point,.up-point+.up-point{padding:14px 0;border-left:0;border-bottom:1px solid var(--ln)}.up-quick-line,.up-do-grid,.up-inside-grid,.up-steps,.up-formula{grid-template-columns:1fr}.up-quick-card,.up-quick-card+.up-quick-card,.up-do-card,.up-do-card+.up-do-card,.up-ingredient,.up-step,.up-step+.up-step,.up-formula-card{padding:28px 0;border-left:0;border-bottom:1px solid var(--ln)}.up-before-after{grid-template-columns:1fr}.up-life-chips,.up-life-images{grid-template-columns:repeat(2,1fr)}.up-life-chip+.up-life-chip{border-left:0}.up-life-img:last-child{display:none}.up-complete-grid{grid-template-columns:1fr}}\n</style>\n\n<section id=\"unfair-pdp\">\n<!-- 01 NAVIGATION is handled by the Shopify theme header -->\n\n<!-- 02 PRODUCT HERO -->\n<div class=\"up-main\">\n  <div class=\"up-gallery-wrap\">\n    <div class=\"up-thumbs\" id=\"up-thumbs\">\n      {% for media in product.media limit: 10 %}\n        {% if media.media_type == 'image' or media.media_type == 'video' %}\n          <button type=\"button\" class=\"up-thumb{% if forloop.first %} is-active{% endif %}\" data-slide=\"{{ forloop.index0 }}\" aria-label=\"View media {{ forloop.index }}\">\n            {{ media.preview_image | image_url: width: 180 | image_tag: loading:'lazy', widths:'90,120,180', sizes:'80px', alt:media.alt | default:product.title }}\n            {% if media.media_type == 'video' %}<span class=\"up-play\">▶</span>{% endif %}\n          </button>\n        {% endif %}\n      {% endfor %}\n    </div>\n    <div class=\"up-slider-shell\">\n      <div class=\"up-slider\" id=\"up-slider\">\n        {% for media in product.media limit: 10 %}\n          {% if media.media_type == 'image' %}\n            <div class=\"up-slide\" data-slide=\"{{ forloop.index0 }}\">{{ media.preview_image | image_url: width:1800 | image_tag: loading:'lazy', widths:'500,700,900,1200,1500,1800', sizes:'(max-width:989px) 100vw,55vw', alt:media.alt | default:product.title }}</div>\n          {% elsif media.media_type == 'video' %}\n            <div class=\"up-slide\"><div style=\"width:100%;height:100%\">{{ media | video_tag: controls:true, image_size:'1400x' }}</div></div>\n          {% endif %}\n        {% endfor %}\n        {% if product.media.size == 0 and product.featured_image %}<div class=\"up-slide\">{{ product.featured_image | image_url:width:1800 | image_tag:loading:'eager', alt:product.title }}</div>{% endif %}\n      </div>\n      <button type=\"button\" class=\"up-gallery-arrow up-prev\" id=\"up-prev\" aria-label=\"Previous media\">←</button>\n      <button type=\"button\" class=\"up-gallery-arrow up-next\" id=\"up-next\" aria-label=\"Next media\">→</button>\n      <div class=\"up-gallery-count\"><span id=\"up-current\">01</span><span>/</span><span id=\"up-total\">{{ product.media.size | at_most: 10 | prepend:'0' | slice:-2,2 }}</span></div>\n    </div>\n  </div>\n\n  <div class=\"up-info\"><div class=\"up-stick\">\n    <div class=\"up-eye\">THE UN-FAIR ADVANTAGE</div>\n    <h1 class=\"up-title\">{{ product.title }}</h1>\n    <div class=\"up-prices\"><span class=\"up-price\" id=\"up-price\">{{ v.price | money }}</span><span class=\"up-compare\" id=\"up-compare\" {% unless v.compare_at_price > v.price %}style=\"display:none\"{% endunless %}>{{ v.compare_at_price | money }}</span>{% if v.compare_at_price > v.price %}<span class=\"up-badge\">UNFAIR PRICE</span>{% endif %}</div>\n    {% if product.description != blank %}<div class=\"up-short\">{{ product.description | strip_html | truncatewords:38 }}</div>{% endif %}\n\n    {% form 'product', product, id:'unfair-product-form', class:'up-form' %}\n      <input type=\"hidden\" name=\"id\" id=\"up-variant-id\" value=\"{{ v.id }}\">\n      {% unless product.has_only_default_variant %}\n        {% for option in product.options_with_values %}<label class=\"up-label\" for=\"up-option-{{ forloop.index }}\">{{ option.name }}</label><select class=\"up-select up-option\" id=\"up-option-{{ forloop.index }}\" data-index=\"{{ forloop.index0 }}\">{% for value in option.values %}<option value=\"{{ value | escape }}\" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>{% endfor %}</select>{% endfor %}\n      {% endunless %}\n      <div class=\"up-actions\"><div class=\"up-qty\"><button type=\"button\" id=\"up-minus\">−</button><input id=\"up-quantity\" type=\"number\" name=\"quantity\" value=\"1\" min=\"1\"><button type=\"button\" id=\"up-plus\">+</button></div><button class=\"up-atc\" id=\"up-atc\" type=\"submit\" name=\"add\" {% unless v.available %}disabled{% endunless %}>{% if v.available %}ADD TO BAG — {{ v.price | money }}{% else %}SOLD OUT{% endif %}</button></div>\n      {{ form | payment_button }}\n    {% endform %}\n    <div class=\"up-status\"><span class=\"up-dot\"></span><span id=\"up-status\">{% if v.available %}AVAILABLE / READY FOR YOUR ROUTINE{% else %}CURRENTLY UNAVAILABLE{% endif %}</span></div>\n\n    <!-- 03 QUICK PRODUCT PROMISE -->\n    <div class=\"up-promise\"><div class=\"up-promise-k\">03 / QUICK PRODUCT PROMISE</div><h3>LOOK BETTER. INSTANTLY.</h3><p>Blur. Matte. Smooth. Then get on with it.</p><div class=\"up-points\"><div class=\"up-point\"><b>Instant visible effect</b><span>Designed for an immediate visual payoff.</span></div><div class=\"up-point\"><b>Lightweight finish</b><span>Built to feel easy inside a real routine.</span></div><div class=\"up-point\"><b>Performance-led</b><span>More than a quick cosmetic fix.</span></div></div></div>\n\n    <div id=\"up-description-source\" class=\"up-desc-source\">{{ product.description }}</div>\n    <div class=\"up-dynamic-details\"><div class=\"up-details-heading\">PRODUCT DETAILS / FROM THE SHOPIFY DESCRIPTION</div><div id=\"up-description-tabs\"></div></div>\n  </div></div>\n</div>\n\n<!-- 04 SEE THE DIFFERENCE -->\n<section class=\"up-difference\"><div class=\"up-difference-inner\"><div class=\"up-diff-head\"><div><span class=\"up-k\">04 / SEE THE DIFFERENCE</span><h2 class=\"up-heading\" style=\"color:#F5F0EC!important\">SEE IT.<br>FEEL THE <em>EDGE.</em></h2></div><p class=\"up-diff-copy\">Use this section for the strongest visual proof for the product. If Before / After images are added through the optional product metafields, they appear here automatically.</p></div>\n<div class=\"up-before-after\">\n  {% if before_img %}<div class=\"up-ba\">{{ before_img | image_url:width:1200 | image_tag:loading:'lazy',alt:'Before result' }}<span>BEFORE</span></div>{% else %}<div class=\"up-ba\">{% if product.images.size > 1 %}{{ product.images[1] | image_url:width:1200 | image_tag:loading:'lazy',alt:product.title }}{% else %}<div style=\"height:100%;display:flex;align-items:center;justify-content:center;color:#F5F0EC!important;font-size:9px;letter-spacing:.15em\">ADD BEFORE IMAGE METAFIELD</div>{% endif %}<span>BEFORE / ADD IMAGE</span></div>{% endif %}\n  {% if after_img %}<div class=\"up-ba\">{{ after_img | image_url:width:1200 | image_tag:loading:'lazy',alt:'After result' }}<span>AFTER</span></div>{% else %}<div class=\"up-ba\">{% if product.images.size > 2 %}{{ product.images[2] | image_url:width:1200 | image_tag:loading:'lazy',alt:product.title }}{% else %}<div style=\"height:100%;display:flex;align-items:center;justify-content:center;color:#F5F0EC!important;font-size:9px;letter-spacing:.15em\">ADD AFTER IMAGE METAFIELD</div>{% endif %}<span>AFTER / ADD IMAGE</span></div>{% endif %}\n</div><div class=\"up-diff-note\">INSTANTLY VISIBLE. UN-FAIR.</div></div></section>\n\n<!-- 05 WHAT DOES IT DO -->\n<section class=\"up-do\"><div class=\"up-section\"><div class=\"up-do-head\"><span class=\"up-k\">05 / WHAT DOES IT DO?</span><h2 class=\"up-heading\">THE <em>RESULT</em><br>YOU NOTICE.</h2></div><div class=\"up-do-grid\"><div class=\"up-do-card\"><span class=\"up-do-num\">01 / VISUAL</span><h3>{{ b1 }}</h3><p>Designed around the product's primary visible effect and the result customers notice first.</p></div><div class=\"up-do-card\"><span class=\"up-do-num\">02 / PERFORMANCE</span><h3>{{ b2 }}</h3><p>Built to support a polished, ready-to-go finish without making the routine feel complicated.</p></div><div class=\"up-do-card\"><span class=\"up-do-num\">03 / FINISH</span><h3>{{ b3 }}</h3><p>More refined-looking results, presented through a simple and intentional product experience.</p></div></div></div></section>\n\n<!-- 06 WHY IT'S UNFAIR -->\n<section class=\"up-why\"><div class=\"up-why-dark\"><span class=\"up-k\">06 / WHY IT'S UNFAIR</span><h2 class=\"up-heading\" style=\"color:#F5F0EC!important\">NOT JUST<br>A QUICK FIX.</h2><p>UN-FAIR is built around two moments: what you can see now and what the product is designed to contribute over time. That combination is the core differentiation.</p></div><div class=\"up-why-side\"><span class=\"up-k\">THE EDGE</span><h3>INSTANT PERFORMANCE + LONG-TERM CARE.</h3><div class=\"up-why-list\"><div class=\"up-why-row\"><span>NOW</span><span>BLUR / MATTE / SMOOTH</span></div><div class=\"up-why-row\"><span>OVER TIME</span><span>CARE / SUPPORT / TREATMENT</span></div><div class=\"up-why-row\"><span>THE RESULT</span><span>MORE OUTPUT / LESS ROUTINE</span></div></div></div></section>\n\n<!-- 07 WHAT'S INSIDE -->\n<section class=\"up-inside\"><div class=\"up-section\"><div class=\"up-inside-head\"><div><span class=\"up-k\">07 / WHAT'S INSIDE</span><h2 class=\"up-heading\">FORMULA<br>WITH A <em>PURPOSE.</em></h2></div><p class=\"up-inside-copy up-muted\">Ingredient names, benefits and formula claims should be maintained in the Shopify product description. The dynamic product-detail accordions above automatically pull that content into the PDP.</p></div><div class=\"up-inside-grid\"><div class=\"up-ingredient\"><small>01 / INGREDIENT</small><h3>FORMULA<br>DETAILS</h3><p>Use the product description for the exact ingredient and benefit information.</p></div><div class=\"up-ingredient\"><small>02 / BENEFIT</small><h3>WHAT IT<br>CONTRIBUTES</h3><p>Explain the role of the ingredient using the approved product copy.</p></div><div class=\"up-ingredient\"><small>03 / TRUST</small><h3>QUALITY<br>MATTERS.</h3><p>Testing, formulation and quality claims can be included in the description and displayed in the accordions.</p></div></div></div></section>\n\n<!-- 08 MADE FOR REAL LIFE -->\n<section class=\"up-life\"><div class=\"up-section\"><span class=\"up-k\">08 / MADE FOR REAL LIFE</span><h2 class=\"up-heading\" style=\"color:#F5F0EC!important\">ONE PRODUCT.<br>ANY <em>PLAN.</em></h2><p class=\"up-life-copy\">Designed to fit around actual life — not the other way around. Use this visual strip for the situations where the product naturally earns its place.</p><div class=\"up-life-chips\"><div class=\"up-life-chip\">DATE NIGHT</div><div class=\"up-life-chip\">OFFICE</div><div class=\"up-life-chip\">PARTY</div><div class=\"up-life-chip\">CAMERA</div><div class=\"up-life-chip\">TRAVEL</div></div><div class=\"up-life-images\">{% assign life_imgs=product.images %}{% for image in life_imgs limit:5 %}<div class=\"up-life-img\">{{ image | image_url:width:700 | image_tag:loading:'lazy',alt:product.title }}</div>{% endfor %}</div></div></section>\n\n<!-- 09 HOW TO USE -->\n<section class=\"up-how\"><div class=\"up-section\"><div class=\"up-how-head\"><div><span class=\"up-k\">09 / HOW TO USE</span><h2 class=\"up-heading\">SIMPLE.<br>FAST. <em>DONE.</em></h2></div><p class=\"up-muted\">The exact usage instructions are pulled from the product description above. The visual steps below provide a consistent brand framework without inventing product-specific directions.</p></div><div class=\"up-steps\"><div class=\"up-step\"><span class=\"up-step-num\">01</span><h3>PREP</h3><p>Prepare according to the product's approved directions.</p></div><div class=\"up-step\"><span class=\"up-step-num\">02</span><h3>APPLY</h3><p>Use the recommended amount and application method from the product description.</p></div><div class=\"up-step\"><span class=\"up-step-num\">03</span><h3>GO</h3><p>Finish your routine and enjoy the intended result.</p></div></div></div></section>\n\n<!-- 10 INGREDIENT / FORMULA TRUST -->\n<section class=\"up-trust\"><div class=\"up-section\"><span class=\"up-k\">10 / INGREDIENT / FORMULA TRUST</span><h2 class=\"up-heading\" style=\"color:#F5F0EC!important\">FORMULATED<br>FOR THE <em>EDGE.</em></h2><div class=\"up-formula\"><div class=\"up-formula-card\"><small>ADVANCED FORMULATION</small><h3>INGREDIENT<br>PROFILE</h3><p>Exact ingredients and their approved benefits should be supplied through the Shopify product description.</p></div><div class=\"up-formula-card\"><small>FORMULA LOGIC</small><h3>WHY IT<br>BELONGS.</h3><p>Explain why each hero ingredient contributes to the product's intended performance.</p></div><div class=\"up-formula-card\"><small>QUALITY</small><h3>TRUST<br>THE FORMULA.</h3><p>Add verified testing, formulation or quality information here through product content.</p></div></div><p class=\"up-trust-note\">Do not add testing, clinical, ingredient or performance claims unless they are supported by the actual product information.</p></div></section>\n\n<!-- 11 CUSTOMER REVIEWS -->\n<section class=\"up-reviews\"><div class=\"up-section\"><span class=\"up-k\">11 / THEY NOTICED</span><h2 class=\"up-heading\">THEY GET<br>THE <em>EDGE.</em></h2><div class=\"up-review-box\">{% if review_quote %}{% if review_rating %}<div class=\"up-stars\">{% for i in (1..5) %}{% if i <= review_rating %}★{% else %}☆{% endif %}{% endfor %}</div>{% else %}<div class=\"up-stars\">★★★★★</div>{% endif %}<div class=\"up-review-quote\">“{{ review_quote }}”</div><div class=\"up-review-author\">{{ review_author }}</div>{% else %}<div class=\"up-stars\">★★★★★</div><div class=\"up-review-empty\">Add a verified review quote through the optional <strong>custom.review_quote</strong> product metafield, or connect your review app's widget here.</div>{% endif %}</div></div></section>\n\n<!-- 12 FAQ / OBJECTION HANDLING -->\n<section class=\"up-faq\"><div class=\"up-faq-in\"><span class=\"up-k\">12 / FAQ / OBJECTION HANDLING</span><h2 class=\"up-heading\">THE DETAILS,<br>WITHOUT THE <em>LECTURE.</em></h2><details><summary>WHAT SKIN TYPE / HAIR TYPE / USE CASE IS IT FOR?</summary><div class=\"up-faq-answer\">See the product-specific information in the DESCRIPTION and other Shopify product-detail tabs above.</div></details><details><summary>HOW LONG DOES THE EFFECT LAST?</summary><div class=\"up-faq-answer\">Duration depends on the individual product and should be stated in the product description if applicable.</div></details><details><summary>WILL IT LOOK CAKEY / HEAVY / GREASY?</summary><div class=\"up-faq-answer\">Use the product's approved finish and application information in the description to answer this question accurately.</div></details><details><summary>CAN I USE IT EVERY DAY?</summary><div class=\"up-faq-answer\">Follow the usage guidance supplied for this specific product.</div></details><details><summary>HOW DO I APPLY IT?</summary><div class=\"up-faq-answer\">Open the HOW TO USE / APPLICATION tab generated from the product description.</div></details><details><summary>CAN I USE IT WITH OTHER PRODUCTS?</summary><div class=\"up-faq-answer\">Any compatibility or layering guidance should be supplied in the product's approved description.</div></details></div></section>\n\n<!-- 13 COMPLETE THE EDGE -->\n<section class=\"up-complete\"><div class=\"up-section\"><div class=\"up-complete-head\"><div><span class=\"up-k\">13 / COMPLETE THE EDGE</span><h2 class=\"up-heading\">YOUR ADVANTAGE<br>DOESN'T <em>STOP HERE.</em></h2></div><p class=\"up-muted\" style=\"max-width:390px\">Build the routine across FACE, HAIR, BODY and FRAGRANCE. The products below are pulled automatically from the store.</p></div><div class=\"up-complete-grid\">{% assign related_collection=collections.all %}{% assign shown=0 %}{% for rp in related_collection.products limit:12 %}{% if rp.id != product.id and shown < 3 %}<a class=\"up-related\" href=\"{{ rp.url }}\"><div class=\"up-related-img\">{% if rp.featured_image %}{{ rp.featured_image | image_url:width:900 | image_tag:loading:'lazy',alt:rp.title }}{% endif %}</div><div class=\"up-related-info\"><h3>{{ rp.title }}</h3><span class=\"up-related-price\">{{ rp.price | money }}</span></div></a>{% assign shown=shown | plus:1 %}{% endif %}{% endfor %}</div></div></section>\n\n<!-- 14 FINAL BRAND STATEMENT -->\n<section class=\"up-final\"><small>14 / FINAL BRAND STATEMENT</small><h2>THE WORLD<br>ISN'T FAIR.<br><em>GOOD.</em><br>NEITHER ARE WE.</h2><a href=\"{{ routes.root_url }}collections/all\">SHOP NOW →</a></section>\n\n</section>\n\n<script>\n(function(){\n  var root=document.getElementById('unfair-pdp');if(!root)return;\n  /* Build product-detail accordions directly from the Shopify product description. */\n  var source=root.querySelector('#up-description-source'),tabs=root.querySelector('#up-description-tabs');\n  if(source&&tabs){\n    var nodes=Array.prototype.slice.call(source.childNodes),sections=[],current=null;\n    nodes.forEach(function(node){var tag=node.nodeType===1?node.tagName.toLowerCase():'';if(tag==='h2'||tag==='h3'||tag==='h4'){current={title:(node.textContent||'').trim(),content:[]};sections.push(current)}else{if(!current){current={title:'DESCRIPTION',content:[]};sections.push(current)}if(node.nodeType===3&&!(node.textContent||'').trim())return;current.content.push(node.cloneNode(true))}});\n    sections=sections.filter(function(s){return s.title||s.content.length});\n    sections.forEach(function(sec,index){var d=document.createElement('details');d.className='up-auto-detail';if(index===0)d.open=true;var sm=document.createElement('summary');sm.textContent=sec.title||'DESCRIPTION';var b=document.createElement('div');b.className='up-auto-body';sec.content.forEach(function(n){b.appendChild(n)});d.appendChild(sm);d.appendChild(b);tabs.appendChild(d)});\n  }\n  var slider=root.querySelector('#up-slider'),thumbs=root.querySelectorAll('.up-thumb'),slides=root.querySelectorAll('.up-slide'),current=root.querySelector('#up-current');\n  function go(i){if(slider&&slides[i])slider.scrollTo({left:slides[i].offsetLeft,behavior:'smooth'})}\n  thumbs.forEach(function(t){t.addEventListener('click',function(){go(parseInt(t.dataset.slide)||0)})});\n  function idx(){return slider&&slides.length?Math.max(0,Math.min(slides.length-1,Math.round(slider.scrollLeft/slider.clientWidth))):0}\n  root.querySelector('#up-prev').addEventListener('click',function(){go(Math.max(0,idx()-1))});root.querySelector('#up-next').addEventListener('click',function(){go(Math.min(slides.length-1,idx()+1))});\n  if(slider){var ticking=false;slider.addEventListener('scroll',function(){if(ticking)return;ticking=true;requestAnimationFrame(function(){var i=idx();thumbs.forEach(function(t,n){t.classList.toggle('is-active',n===i)});if(current)current.textContent=String(i+1).padStart(2,'0');ticking=false})},{passive:true})}\n  var variants={{ product.variants | json }},selects=root.querySelectorAll('.up-option'),id=root.querySelector('#up-variant-id'),price=root.querySelector('#up-price'),compare=root.querySelector('#up-compare'),atc=root.querySelector('#up-atc'),status=root.querySelector('#up-status'),qty=root.querySelector('#up-quantity'),moneyFormat={{ shop.money_format | json }};\n  function money(c){var value=(c/100).toFixed(2);if(moneyFormat.indexOf('{{amount_no_decimals}}')>-1)value=Math.round(c/100).toString();return moneyFormat.replace(/\\{\\{\\s*amount(_no_decimals)?\\s*\\}\\}/,value)}\n  function updateVariant(){var options=[];selects.forEach(function(s){options[parseInt(s.dataset.index)]=s.value});var found=variants.find(function(x){return x.options.every(function(o,i){return o===options[i]})});if(!found)return;id.value=found.id;price.textContent=money(found.price);if(found.compare_at_price&&found.compare_at_price>found.price){compare.style.display='inline';compare.textContent=money(found.compare_at_price)}else compare.style.display='none';atc.disabled=!found.available;atc.textContent=found.available?'ADD TO BAG — '+money(found.price):'SOLD OUT';status.textContent=found.available?'AVAILABLE / READY FOR YOUR ROUTINE':'CURRENTLY UNAVAILABLE'}\n  selects.forEach(function(s){s.addEventListener('change',updateVariant)});root.querySelector('#up-minus').addEventListener('click',function(){qty.value=Math.max(1,(parseInt(qty.value)||1)-1)});root.querySelector('#up-plus').addEventListener('click',function(){qty.value=(parseInt(qty.value)||1)+1});\n})();\n</script>\n{% endif %}",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
  },
  "order": [
    "main",
    "related-products",
    "custom_liquid_HnNwAN"
  ]
