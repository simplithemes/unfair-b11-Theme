      "settings": {
        "custom_liquid": "{% comment %}\n===========================================================\nUNFAIR — COLLECTION PAGE V3\nFIXED PRODUCT GRID\n- No blue\n- No overlapping products\n- No cards entering adjacent sections\n- Fixed product image area\n- Equal product-card structure\n- Theme CSS isolation\n- Responsive\n===========================================================\n{% endcomment %}\n\n<style>\n\n/* =========================================================\n   GLOBAL\n========================================================= */\n\n#ufCollectionV2 {\n  --bg: #f4f0ec;\n  --paper: #ffffff;\n  --ink: #171716;\n  --muted: #716d69;\n  --accent: #b16f5e;\n  --accent-dark: #8f594b;\n  --line: rgba(23,23,22,.14);\n  --dark: #151617;\n  --gap: 18px;\n\n  width: 100%;\n  max-width: 100%;\n  position: relative;\n  background: var(--bg);\n  color: var(--ink);\n  overflow: hidden;\n  font-family: inherit;\n  isolation: isolate;\n}\n\n#ufCollectionV2 *,\n#ufCollectionV2 *::before,\n#ufCollectionV2 *::after {\n  box-sizing: border-box;\n}\n\n#ufCollectionV2 a {\n  color: inherit;\n  text-decoration: none;\n}\n\n#ufCollectionV2 img {\n  max-width: 100%;\n}\n\n.uf2-container {\n  width: min(1320px, calc(100% - 64px));\n  margin-inline: auto;\n  position: relative;\n}\n\n.uf2-section {\n  position: relative;\n  width: 100%;\n  padding: 72px 0;\n  clear: both;\n}\n\n.uf2-divider {\n  border-bottom: 1px solid var(--line);\n}\n\n.uf2-kicker {\n  margin: 0 0 13px;\n  color: var(--accent);\n  font-size: 10px;\n  line-height: 1;\n  font-weight: 700;\n  letter-spacing: .2em;\n  text-transform: uppercase;\n}\n\n.uf2-title {\n  margin: 0;\n  max-width: 720px;\n  color: var(--ink);\n  font-size: clamp(34px,4vw,58px);\n  line-height: .98;\n  font-weight: 500;\n  letter-spacing: -.055em;\n  text-transform: uppercase;\n}\n\n.uf2-copy {\n  max-width: 520px;\n  margin: 18px 0 0;\n  color: var(--muted);\n  font-size: 13px;\n  line-height: 1.65;\n}\n\n.uf2-header-row {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  gap: 30px;\n  margin-bottom: 32px;\n}\n\n.uf2-text-link {\n  flex: 0 0 auto;\n  padding-bottom: 5px;\n  border-bottom: 1px solid currentColor;\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: .15em;\n  text-transform: uppercase;\n}\n\n\n/* =========================================================\n   NAV\n========================================================= */\n\n.uf2-nav {\n  position: relative;\n  width: 100%;\n  border-bottom: 1px solid var(--line);\n  background: var(--bg);\n}\n\n.uf2-nav-inner {\n  min-height: 64px;\n  display: flex;\n  align-items: center;\n  gap: 38px;\n}\n\n.uf2-logo {\n  flex: 0 0 auto;\n  font-size: 20px;\n  font-weight: 800;\n  letter-spacing: -.055em;\n  text-transform: lowercase;\n}\n\n.uf2-nav-links {\n  display: flex;\n  align-items: center;\n  gap: 26px;\n  flex: 1;\n}\n\n.uf2-nav-links a,\n.uf2-nav-tools a {\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: .14em;\n  text-transform: uppercase;\n}\n\n.uf2-nav-links a {\n  position: relative;\n}\n\n.uf2-nav-links a::after {\n  content: \"\";\n  position: absolute;\n  height: 1px;\n  left: 0;\n  right: 100%;\n  bottom: -7px;\n  background: var(--accent);\n  transition: right .25s ease;\n}\n\n.uf2-nav-links a:hover::after {\n  right: 0;\n}\n\n.uf2-nav-tools {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n}\n\n\n/* =========================================================\n   HERO\n========================================================= */\n\n.uf2-hero {\n  position: relative;\n  width: 100%;\n  padding: 28px 0 54px;\n}\n\n.uf2-hero-grid {\n  display: grid;\n  grid-template-columns: minmax(310px,.7fr) minmax(0,1.3fr);\n  gap: 28px;\n  align-items: center;\n}\n\n.uf2-hero-copy {\n  padding: 34px 20px 34px 0;\n}\n\n.uf2-hero-title {\n  margin: 0;\n  max-width: 470px;\n  font-size: clamp(44px,5.2vw,72px);\n  line-height: .89;\n  font-weight: 500;\n  letter-spacing: -.065em;\n  text-transform: uppercase;\n}\n\n.uf2-hero-title em {\n  color: var(--accent);\n  font-style: normal;\n}\n\n.uf2-hero-desc {\n  max-width: 390px;\n  margin: 22px 0 0;\n  color: var(--muted);\n  font-size: 13px;\n  line-height: 1.6;\n}\n\n.uf2-hero-actions {\n  display: flex;\n  align-items: center;\n  gap: 22px;\n  margin-top: 27px;\n}\n\n.uf2-button {\n  min-height: 46px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  padding: 0 22px;\n  background: var(--ink);\n  color: #fff !important;\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: .15em;\n  text-transform: uppercase;\n  transition: .25s ease;\n}\n\n.uf2-button:hover {\n  background: var(--accent);\n}\n\n.uf2-hero-art {\n  width: 100%;\n  overflow: hidden;\n  background: #e8e2dd;\n}\n\n.uf2-hero-art img {\n  display: block !important;\n  position: static !important;\n  float: none !important;\n  width: 100% !important;\n  height: auto !important;\n  max-height: 640px;\n  object-fit: contain;\n  object-position: center;\n}\n\n\n/* =========================================================\n   CATEGORY\n========================================================= */\n\n.uf2-category-grid {\n  display: grid;\n  grid-template-columns: repeat(4,minmax(0,1fr));\n  gap: var(--gap);\n}\n\n.uf2-category-card {\n  display: block;\n  min-width: 0;\n}\n\n.uf2-category-media {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 4 / 5;\n  overflow: hidden;\n  background: #e5dfda;\n}\n\n.uf2-category-media img {\n  display: block !important;\n  position: static !important;\n  float: none !important;\n  width: 100% !important;\n  height: 100% !important;\n  object-fit: cover;\n  object-position: center;\n  transition: transform .5s ease;\n}\n\n.uf2-category-card:hover .uf2-category-media img {\n  transform: scale(1.025);\n}\n\n.uf2-category-index {\n  position: absolute;\n  top: 12px;\n  left: 12px;\n  width: 28px;\n  height: 28px;\n  display: grid;\n  place-items: center;\n  border-radius: 50%;\n  background: rgba(244,240,236,.93);\n  color: var(--ink);\n  font-size: 8px;\n  font-weight: 700;\n}\n\n.uf2-category-copy {\n  padding: 14px 1px 0;\n}\n\n.uf2-category-copy h3 {\n  margin: 0;\n  font-size: 14px;\n  font-weight: 600;\n  letter-spacing: -.02em;\n  text-transform: uppercase;\n}\n\n.uf2-category-copy span {\n  display: inline-block;\n  margin-top: 6px;\n  color: var(--accent);\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: .13em;\n  text-transform: uppercase;\n}\n\n\n/* =========================================================\n   FILTER / SORT\n========================================================= */\n\n.uf2-toolbar {\n  position: relative;\n  width: 100%;\n  padding: 17px 0;\n  border-top: 1px solid var(--line);\n  border-bottom: 1px solid var(--line);\n  background: var(--bg);\n  clear: both;\n}\n\n.uf2-toolbar-inner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 25px;\n}\n\n.uf2-filter-list {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 7px;\n}\n\n.uf2-filter-btn {\n  border: 1px solid var(--line);\n  background: transparent;\n  padding: 9px 14px;\n  color: var(--ink);\n  font: inherit;\n  font-size: 8px;\n  font-weight: 700;\n  letter-spacing: .14em;\n  text-transform: uppercase;\n  cursor: pointer;\n}\n\n.uf2-filter-btn:hover,\n.uf2-filter-btn.is-active {\n  border-color: var(--ink);\n  background: var(--ink);\n  color: #fff;\n}\n\n.uf2-sort {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.uf2-sort label {\n  font-size: 8px;\n  font-weight: 700;\n  letter-spacing: .14em;\n  text-transform: uppercase;\n}\n\n.uf2-sort select {\n  width: 145px;\n  border: 0;\n  border-bottom: 1px solid var(--ink);\n  border-radius: 0;\n  background: transparent;\n  padding: 8px 2px;\n  color: var(--ink);\n  font: inherit;\n  font-size: 10px;\n  outline: none;\n}\n\n\n/* =========================================================\n   PRODUCT GRID — FIXED\n========================================================= */\n\n#ufCollectionV2 .uf2-products {\n  width: 100%;\n  display: grid !important;\n  grid-template-columns: repeat(4,minmax(0,1fr)) !important;\n  column-gap: 20px !important;\n  row-gap: 52px !important;\n  align-items: start !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  position: relative !important;\n  float: none !important;\n  clear: both !important;\n}\n\n\n/* Every product is its own isolated grid cell */\n\n#ufCollectionV2 .uf2-product {\n  display: flex !important;\n  flex-direction: column !important;\n\n  width: 100% !important;\n  min-width: 0 !important;\n  max-width: 100% !important;\n\n  height: auto !important;\n  min-height: 0 !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  position: relative !important;\n  inset: auto !important;\n\n  float: none !important;\n  clear: none !important;\n\n  transform: none;\n  overflow: visible;\n\n  align-self: start !important;\n}\n\n\n/* =========================================================\n   PRODUCT IMAGE BOX\n========================================================= */\n\n#ufCollectionV2 .uf2-product-media {\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n\n  position: relative !important;\n\n  width: 100% !important;\n  height: auto !important;\n  min-height: 0 !important;\n\n  aspect-ratio: 1 / 1.18 !important;\n\n  margin: 0 !important;\n  padding: 20px !important;\n\n  overflow: hidden !important;\n\n  background: #f8f7f5;\n\n  isolation: isolate;\n}\n\n\n/* Critical Shopify theme override */\n\n#ufCollectionV2 .uf2-product-media img,\n#ufCollectionV2 .uf2-product-media > img,\n#ufCollectionV2 .uf2-product-media picture,\n#ufCollectionV2 .uf2-product-media picture img {\n  display: block !important;\n\n  position: static !important;\n  inset: auto !important;\n\n  float: none !important;\n\n  width: 100% !important;\n  height: 100% !important;\n\n  max-width: 100% !important;\n  max-height: 100% !important;\n\n  margin: 0 auto !important;\n  padding: 0 !important;\n\n  object-fit: contain !important;\n  object-position: center center !important;\n\n  transform: none;\n}\n\n\n/* Hover stays inside its own card */\n\n#ufCollectionV2 .uf2-product:hover .uf2-product-media img {\n  transform: scale(1.018);\n}\n\n\n/* =========================================================\n   BADGE\n========================================================= */\n\n#ufCollectionV2 .uf2-badge {\n  position: absolute !important;\n  z-index: 3;\n  top: 12px;\n  left: 12px;\n\n  padding: 6px 8px;\n\n  background: var(--ink);\n  color: #fff;\n\n  font-size: 7px;\n  font-weight: 700;\n  letter-spacing: .13em;\n  line-height: 1;\n  text-transform: uppercase;\n}\n\n\n/* =========================================================\n   PRODUCT INFORMATION\n========================================================= */\n\n#ufCollectionV2 .uf2-product-info {\n  display: flex !important;\n  flex-direction: column !important;\n\n  position: static !important;\n\n  width: 100% !important;\n  min-width: 0 !important;\n\n  padding: 16px 2px 0 !important;\n  margin: 0 !important;\n\n  float: none !important;\n  clear: both !important;\n\n  background: transparent !important;\n}\n\n\n/* title */\n\n#ufCollectionV2 .uf2-product-name {\n  margin: 0 !important;\n\n  min-height: 32px;\n\n  font-size: 12px;\n  line-height: 1.35;\n  font-weight: 700;\n\n  letter-spacing: .01em;\n  text-transform: uppercase;\n\n  overflow-wrap: anywhere;\n}\n\n#ufCollectionV2 .uf2-product-name a {\n  display: block;\n}\n\n\n/* description */\n\n#ufCollectionV2 .uf2-product-benefit {\n  display: -webkit-box;\n\n  min-height: 43px;\n  max-height: 43px;\n\n  margin: 8px 0 0 !important;\n\n  overflow: hidden;\n\n  color: var(--muted);\n\n  font-size: 10px;\n  line-height: 1.45;\n\n  -webkit-line-clamp: 3;\n  -webkit-box-orient: vertical;\n}\n\n\n/* stars */\n\n#ufCollectionV2 .uf2-stars {\n  display: block;\n\n  margin: 10px 0 0 !important;\n\n  font-size: 9px;\n  line-height: 1;\n  letter-spacing: 1.5px;\n}\n\n\n/* price/footer */\n\n#ufCollectionV2 .uf2-product-footer {\n  width: 100%;\n\n  display: flex !important;\n  align-items: center !important;\n  justify-content: space-between !important;\n\n  gap: 12px;\n\n  margin: 11px 0 0 !important;\n  padding: 0 !important;\n\n  position: static !important;\n}\n\n#ufCollectionV2 .uf2-price {\n  flex: 0 0 auto;\n\n  font-size: 11px;\n  line-height: 1.2;\n  font-weight: 700;\n}\n\n#ufCollectionV2 .uf2-shop-link {\n  flex: 0 0 auto;\n\n  padding-bottom: 3px;\n\n  border-bottom: 1px solid var(--ink);\n\n  font-size: 8px;\n  line-height: 1.2;\n  font-weight: 700;\n\n  letter-spacing: .12em;\n  text-transform: uppercase;\n}\n\n\n/* =========================================================\n   BESTSELLERS\n========================================================= */\n\n.uf2-bestsellers {\n  position: relative;\n  width: 100%;\n  background: var(--paper);\n  overflow: hidden;\n}\n\n\n/* =========================================================\n   RESULTS\n========================================================= */\n\n.uf2-results {\n  position: relative;\n  width: 100%;\n  background: var(--dark);\n  color: #f5f0ec;\n  clear: both;\n}\n\n.uf2-results .uf2-title {\n  color: #f5f0ec;\n}\n\n.uf2-result-grid {\n  display: grid;\n  grid-template-columns: repeat(4,minmax(0,1fr));\n  gap: 16px;\n  margin-top: 34px;\n}\n\n.uf2-result-card {\n  display: block;\n  min-width: 0;\n}\n\n.uf2-result-media {\n  width: 100%;\n  aspect-ratio: 3 / 4;\n  overflow: hidden;\n  background: #242424;\n}\n\n.uf2-result-media img {\n  display: block !important;\n  position: static !important;\n  float: none !important;\n  width: 100% !important;\n  height: 100% !important;\n  object-fit: cover;\n  object-position: center;\n  transition: transform .45s ease;\n}\n\n.uf2-result-card:hover img {\n  transform: scale(1.025);\n}\n\n.uf2-result-info {\n  padding: 14px 1px 0;\n}\n\n.uf2-result-info small {\n  display: block;\n  color: var(--accent);\n  font-size: 8px;\n  font-weight: 700;\n  letter-spacing: .16em;\n  text-transform: uppercase;\n}\n\n.uf2-result-info h3 {\n  margin: 7px 0 0;\n  color: #f5f0ec;\n  font-size: 18px;\n  line-height: 1;\n  font-weight: 500;\n  letter-spacing: -.025em;\n  text-transform: uppercase;\n}\n\n.uf2-result-info p {\n  margin: 7px 0 0;\n  color: rgba(245,240,236,.58);\n  font-size: 9px;\n  letter-spacing: .1em;\n  text-transform: uppercase;\n}\n\n\n/* =========================================================\n   ALL PRODUCTS\n========================================================= */\n\n.uf2-all-products {\n  position: relative;\n  width: 100%;\n  background: var(--bg);\n  overflow: hidden;\n  clear: both;\n}\n\n.uf2-load {\n  width: 100%;\n  margin-top: 48px;\n  text-align: center;\n  clear: both;\n}\n\n.uf2-outline-button {\n  min-width: 175px;\n  min-height: 45px;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  border: 1px solid var(--ink);\n  padding: 0 20px;\n\n  font-size: 8px;\n  font-weight: 700;\n  letter-spacing: .15em;\n  text-transform: uppercase;\n}\n\n\n/* =========================================================\n   WHY UNFAIR\n========================================================= */\n\n.uf2-why {\n  position: relative;\n  width: 100%;\n  background: var(--paper);\n  clear: both;\n}\n\n.uf2-why-grid {\n  display: grid;\n  grid-template-columns: minmax(0,.9fr) minmax(0,1.1fr);\n  gap: 52px;\n  align-items: center;\n}\n\n.uf2-why-title em {\n  display: block;\n  color: var(--accent);\n  font-style: normal;\n}\n\n.uf2-benefits {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  margin-top: 32px;\n  border-top: 1px solid var(--line);\n  border-bottom: 1px solid var(--line);\n}\n\n.uf2-benefit {\n  padding: 24px 22px 24px 0;\n}\n\n.uf2-benefit + .uf2-benefit {\n  padding-left: 22px;\n  border-left: 1px solid var(--line);\n}\n\n.uf2-benefit small {\n  color: var(--accent);\n  font-size: 8px;\n  font-weight: 700;\n  letter-spacing: .14em;\n}\n\n.uf2-benefit h3 {\n  margin: 13px 0 0;\n  font-size: 16px;\n  line-height: 1.2;\n  font-weight: 500;\n  text-transform: uppercase;\n}\n\n.uf2-benefit p {\n  margin: 8px 0 0;\n  color: var(--muted);\n  font-size: 11px;\n  line-height: 1.55;\n}\n\n.uf2-why-art {\n  width: 100%;\n  background: #eee8e3;\n  overflow: hidden;\n}\n\n.uf2-why-art img {\n  display: block !important;\n  position: static !important;\n  float: none !important;\n\n  width: 100% !important;\n  height: auto !important;\n  max-height: 650px;\n\n  object-fit: contain;\n  object-position: center;\n}\n\n\n/* =========================================================\n   SOCIAL PROOF\n========================================================= */\n\n.uf2-proof {\n  position: relative;\n  width: 100%;\n  background: var(--bg);\n  clear: both;\n}\n\n.uf2-review-grid {\n  display: grid;\n  grid-template-columns: repeat(3,minmax(0,1fr));\n  gap: 16px;\n}\n\n.uf2-review {\n  min-height: 205px;\n  padding: 28px;\n  background: var(--paper);\n  border: 1px solid var(--line);\n}\n\n.uf2-review-stars {\n  font-size: 10px;\n  letter-spacing: 2px;\n}\n\n.uf2-review blockquote {\n  margin: 25px 0 0;\n  font-size: 21px;\n  line-height: 1.15;\n  font-weight: 500;\n  letter-spacing: -.025em;\n}\n\n.uf2-review-author {\n  margin-top: 24px;\n  color: var(--muted);\n  font-size: 8px;\n  font-weight: 700;\n  letter-spacing: .14em;\n  text-transform: uppercase;\n}\n\n\n/* =========================================================\n   EDITORIAL\n========================================================= */\n\n.uf2-editorial {\n  position: relative;\n  width: 100%;\n  padding: 72px 0;\n  background: var(--paper);\n  clear: both;\n}\n\n.uf2-editorial-heading {\n  margin-bottom: 28px;\n}\n\n.uf2-editorial-art {\n  width: 100%;\n  background: #e6dfda;\n  overflow: hidden;\n}\n\n.uf2-editorial-art img {\n  display: block !important;\n  position: static !important;\n  float: none !important;\n\n  width: 100% !important;\n  height: auto !important;\n\n  max-height: 720px;\n\n  object-fit: contain;\n  object-position: center;\n}\n\n\n/* =========================================================\n   FINAL\n========================================================= */\n\n.uf2-final {\n  position: relative;\n  width: 100%;\n\n  padding: 92px 0;\n\n  background: var(--accent);\n  text-align: center;\n\n  clear: both;\n}\n\n.uf2-final-title {\n  max-width: 800px;\n  margin: 0 auto;\n\n  color: #f8f3ef;\n\n  font-size: clamp(42px,5.4vw,72px);\n  line-height: .93;\n  font-weight: 500;\n\n  letter-spacing: -.055em;\n  text-transform: uppercase;\n}\n\n.uf2-final-button {\n  margin-top: 34px;\n}\n\n\n/* =========================================================\n   TABLET\n========================================================= */\n\n@media (max-width: 989px) {\n\n  .uf2-container {\n    width: calc(100% - 40px);\n  }\n\n  .uf2-section {\n    padding: 58px 0;\n  }\n\n  .uf2-nav-inner {\n    overflow-x: auto;\n  }\n\n  .uf2-nav-links {\n    white-space: nowrap;\n  }\n\n  .uf2-nav-tools {\n    display: none;\n  }\n\n  .uf2-hero-grid {\n    grid-template-columns: 1fr;\n    gap: 22px;\n  }\n\n  .uf2-hero-copy {\n    padding: 30px 0 10px;\n  }\n\n  .uf2-hero-art img {\n    max-height: none;\n  }\n\n  .uf2-category-grid,\n  #ufCollectionV2 .uf2-products,\n  .uf2-result-grid {\n    grid-template-columns: repeat(2,minmax(0,1fr)) !important;\n  }\n\n  #ufCollectionV2 .uf2-products {\n    column-gap: 18px !important;\n    row-gap: 44px !important;\n  }\n\n  .uf2-why-grid {\n    grid-template-columns: 1fr;\n    gap: 36px;\n  }\n\n  .uf2-why-art img {\n    max-height: none;\n  }\n}\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media (max-width: 640px) {\n\n  #ufCollectionV2 {\n    --gap: 10px;\n  }\n\n  .uf2-container {\n    width: calc(100% - 28px);\n  }\n\n  .uf2-section {\n    padding: 48px 0;\n  }\n\n  .uf2-title {\n    font-size: 34px;\n  }\n\n  .uf2-header-row {\n    align-items: flex-start;\n    margin-bottom: 24px;\n  }\n\n  .uf2-nav-inner {\n    min-height: 58px;\n    gap: 20px;\n  }\n\n  .uf2-nav-links {\n    gap: 19px;\n  }\n\n  .uf2-hero {\n    padding: 18px 0 42px;\n  }\n\n  .uf2-hero-title {\n    font-size: 48px;\n  }\n\n  .uf2-hero-desc {\n    font-size: 12px;\n  }\n\n  .uf2-category-grid,\n  #ufCollectionV2 .uf2-products {\n    grid-template-columns: repeat(2,minmax(0,1fr)) !important;\n  }\n\n  #ufCollectionV2 .uf2-products {\n    column-gap: 10px !important;\n    row-gap: 34px !important;\n  }\n\n  #ufCollectionV2 .uf2-product-media {\n    aspect-ratio: 1 / 1.22 !important;\n    padding: 10px !important;\n  }\n\n  #ufCollectionV2 .uf2-product-info {\n    padding-top: 11px !important;\n  }\n\n  #ufCollectionV2 .uf2-product-name {\n    min-height: 30px;\n    font-size: 10px;\n  }\n\n  #ufCollectionV2 .uf2-product-benefit {\n    min-height: 40px;\n    max-height: 40px;\n    font-size: 9px;\n\n    -webkit-line-clamp: 3;\n  }\n\n  #ufCollectionV2 .uf2-product-footer {\n    gap: 6px;\n  }\n\n  #ufCollectionV2 .uf2-price {\n    font-size: 9px;\n  }\n\n  #ufCollectionV2 .uf2-shop-link {\n    font-size: 7px;\n  }\n\n  .uf2-category-copy h3 {\n    font-size: 11px;\n  }\n\n  .uf2-toolbar-inner {\n    display: block;\n  }\n\n  .uf2-filter-list {\n    flex-wrap: nowrap;\n    overflow-x: auto;\n    padding-bottom: 10px;\n  }\n\n  .uf2-filter-btn {\n    flex: 0 0 auto;\n  }\n\n  .uf2-sort {\n    justify-content: space-between;\n    margin-top: 7px;\n  }\n\n  .uf2-result-grid {\n    display: flex;\n    overflow-x: auto;\n    gap: 10px;\n    padding-bottom: 8px;\n    scroll-snap-type: x mandatory;\n  }\n\n  .uf2-result-card {\n    flex: 0 0 74vw;\n    scroll-snap-align: start;\n  }\n\n  .uf2-benefits {\n    grid-template-columns: 1fr;\n  }\n\n  .uf2-benefit + .uf2-benefit {\n    padding-left: 0;\n    border-left: 0;\n    border-top: 1px solid var(--line);\n  }\n\n  .uf2-review-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .uf2-review {\n    min-height: 170px;\n  }\n\n  .uf2-editorial {\n    padding: 48px 0;\n  }\n\n  .uf2-final {\n    padding: 70px 0;\n  }\n\n  .uf2-final-title {\n    font-size: 42px;\n  }\n}\n\n\n/* =========================================================\n   VERY SMALL MOBILE\n========================================================= */\n\n@media (max-width: 390px) {\n\n  #ufCollectionV2 .uf2-products {\n    grid-template-columns: 1fr !important;\n    row-gap: 38px !important;\n  }\n\n  #ufCollectionV2 .uf2-product-media {\n    aspect-ratio: 1 / 1.05 !important;\n    padding: 18px !important;\n  }\n\n  #ufCollectionV2 .uf2-product-name {\n    min-height: 0;\n    font-size: 12px;\n  }\n\n  #ufCollectionV2 .uf2-product-benefit {\n    min-height: 0;\n    max-height: none;\n    font-size: 10px;\n\n    -webkit-line-clamp: 2;\n  }\n}\n\n</style>\n\n\n<div id=\"ufCollectionV2\">\n\n\n<!-- ======================================================\n     NAVIGATION\n====================================================== -->\n\n<nav class=\"uf2-nav\">\n\n  <div class=\"uf2-container uf2-nav-inner\">\n\n    <a href=\"/\" class=\"uf2-logo\">\n      unfair\n    </a>\n\n    <div class=\"uf2-nav-links\">\n      <a href=\"/collections/all\">Shop</a>\n      <a href=\"/collections/face\">Face</a>\n      <a href=\"/collections/hair\">Hair</a>\n      <a href=\"/collections/body\">Body</a>\n      <a href=\"/collections/fragrance\">Fragrance</a>\n    </div>\n\n    <div class=\"uf2-nav-tools\">\n      <a href=\"/search\">Search</a>\n      <a href=\"/account\">Account</a>\n      <a href=\"/cart\">Bag ({{ cart.item_count }})</a>\n    </div>\n\n  </div>\n\n</nav>\n\n\n<!-- ======================================================\n     HERO\n====================================================== -->\n\n<section class=\"uf2-hero uf2-divider\">\n\n  <div class=\"uf2-container uf2-hero-grid\">\n\n    <div class=\"uf2-hero-copy\">\n\n      <div class=\"uf2-kicker\">\n        The unfair advantage\n      </div>\n\n      <h1 class=\"uf2-hero-title\">\n        Shop the<br>\n        <em>advantage.</em>\n      </h1>\n\n      <p class=\"uf2-hero-desc\">\n        High-performance grooming. No boring basics.\n        More results, less effort — built for an immediate\n        upgrade and a longer-term edge.\n      </p>\n\n      <div class=\"uf2-hero-actions\">\n\n        <a href=\"#uf2-all\" class=\"uf2-button\">\n          Shop all →\n        </a>\n\n        <a href=\"#uf2-results\" class=\"uf2-text-link\">\n          Shop by result\n        </a>\n\n      </div>\n\n    </div>\n\n\n    <div class=\"uf2-hero-art\">\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0809/1985/5353/files/sh10.png?v=1790582326\"\n        alt=\"UNFAIR campaign\"\n        width=\"1200\"\n        height=\"900\"\n        loading=\"eager\"\n        fetchpriority=\"high\">\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<!-- ======================================================\n     SHOP BY CATEGORY\n====================================================== -->\n\n<section class=\"uf2-section uf2-divider\">\n\n  <div class=\"uf2-container\">\n\n    <div class=\"uf2-header-row\">\n\n      <div>\n\n        <div class=\"uf2-kicker\">\n          Shop by category\n        </div>\n\n        <h2 class=\"uf2-title\">\n          Find your edge.\n        </h2>\n\n      </div>\n\n    </div>\n\n\n    <div class=\"uf2-category-grid\">\n\n      <a href=\"/collections/face\" class=\"uf2-category-card\">\n\n        <div class=\"uf2-category-media\">\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0809/1985/5353/files/sh4.png?v=1790578440\"\n            alt=\"Face\"\n            loading=\"lazy\">\n\n          <span class=\"uf2-category-index\">01</span>\n\n        </div>\n\n        <div class=\"uf2-category-copy\">\n          <h3>Face</h3>\n          <span>Get sharper →</span>\n        </div>\n\n      </a>\n\n\n      <a href=\"/collections/hair\" class=\"uf2-category-card\">\n\n        <div class=\"uf2-category-media\">\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0809/1985/5353/files/sh6.png?v=1790579884\"\n            alt=\"Hair\"\n            loading=\"lazy\">\n\n          <span class=\"uf2-category-index\">02</span>\n\n        </div>\n\n        <div class=\"uf2-category-copy\">\n          <h3>Hair</h3>\n          <span>Get bounce →</span>\n        </div>\n\n      </a>\n\n\n      <a href=\"/collections/body\" class=\"uf2-category-card\">\n\n        <div class=\"uf2-category-media\">\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0809/1985/5353/files/sh8.png?v=1790580282\"\n            alt=\"Body\"\n            loading=\"lazy\">\n\n          <span class=\"uf2-category-index\">03</span>\n\n        </div>\n\n        <div class=\"uf2-category-copy\">\n          <h3>Body</h3>\n          <span>Get fresh →</span>\n        </div>\n\n      </a>\n\n\n      <a href=\"/collections/fragrance\" class=\"uf2-category-card\">\n\n        <div class=\"uf2-category-media\">\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0809/1985/5353/files/Untitled_Design_69.png?v=1790578070\"\n            alt=\"Fragrance\"\n            loading=\"lazy\">\n\n          <span class=\"uf2-category-index\">04</span>\n\n        </div>\n\n        <div class=\"uf2-category-copy\">\n          <h3>Fragrance</h3>\n          <span>Get noticed →</span>\n        </div>\n\n      </a>\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<!-- ======================================================\n     FILTER / SORT\n====================================================== -->\n\n<section class=\"uf2-toolbar\">\n\n  <div class=\"uf2-container uf2-toolbar-inner\">\n\n    <div class=\"uf2-filter-list\">\n\n      <button type=\"button\"\n        class=\"uf2-filter-btn is-active\"\n        data-filter=\"all\">\n        All\n      </button>\n\n      <button type=\"button\"\n        class=\"uf2-filter-btn\"\n        data-filter=\"face\">\n        Face\n      </button>\n\n      <button type=\"button\"\n        class=\"uf2-filter-btn\"\n        data-filter=\"hair\">\n        Hair\n      </button>\n\n      <button type=\"button\"\n        class=\"uf2-filter-btn\"\n        data-filter=\"body\">\n        Body\n      </button>\n\n      <button type=\"button\"\n        class=\"uf2-filter-btn\"\n        data-filter=\"fragrance\">\n        Fragrance\n      </button>\n\n    </div>\n\n\n    <div class=\"uf2-sort\">\n\n      <label for=\"uf2Sort\">\n        Sort\n      </label>\n\n      <select id=\"uf2Sort\">\n\n        <option value=\"featured\">\n          Featured\n        </option>\n\n        <option value=\"price-low\">\n          Price: low to high\n        </option>\n\n        <option value=\"price-high\">\n          Price: high to low\n        </option>\n\n        <option value=\"az\">\n          A–Z\n        </option>\n\n      </select>\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<!-- ======================================================\n     BESTSELLERS\n====================================================== -->\n\n<section class=\"uf2-section uf2-bestsellers uf2-divider\">\n\n  <div class=\"uf2-container\">\n\n    <div class=\"uf2-header-row\">\n\n      <div>\n\n        <div class=\"uf2-kicker\">\n          Bestsellers\n        </div>\n\n        <h2 class=\"uf2-title\">\n          The ones with an edge.\n        </h2>\n\n      </div>\n\n      <a href=\"#uf2-all\" class=\"uf2-text-link\">\n        View all\n      </a>\n\n    </div>\n\n\n    <div class=\"uf2-products\">\n\n      {% for product in collection.products limit: 4 %}\n\n        <article class=\"uf2-product\">\n\n          <a\n            href=\"{{ product.url }}\"\n            class=\"uf2-product-media\">\n\n            {% if product.featured_image %}\n\n              {{\n                product.featured_image\n                | image_url: width: 800\n                | image_tag:\n                  loading: 'lazy',\n                  widths: '300,400,500,600,700,800',\n                  sizes: '(max-width: 640px) 50vw, (max-width: 989px) 50vw, 25vw',\n                  alt: product.title\n              }}\n\n            {% endif %}\n\n            <span class=\"uf2-badge\">\n              Bestseller\n            </span>\n\n          </a>\n\n\n          <div class=\"uf2-product-info\">\n\n            <h3 class=\"uf2-product-name\">\n              <a href=\"{{ product.url }}\">\n                {{ product.title }}\n              </a>\n            </h3>\n\n\n            <p class=\"uf2-product-benefit\">\n\n              {% if product.metafields.custom.short_benefit != blank %}\n\n                {{ product.metafields.custom.short_benefit }}\n\n              {% elsif product.description != blank %}\n\n                {{ product.description | strip_html | truncate: 80 }}\n\n              {% else %}\n\n                More results. Less effort.\n\n              {% endif %}\n\n            </p>\n\n\n            <div class=\"uf2-stars\">\n              ★★★★★\n            </div>\n\n\n            <div class=\"uf2-product-footer\">\n\n              <span class=\"uf2-price\">\n                {{ product.price | money }}\n              </span>\n\n              <a\n                href=\"{{ product.url }}\"\n                class=\"uf2-shop-link\">\n                Shop →\n              </a>\n\n            </div>\n\n          </div>\n\n        </article>\n\n      {% endfor %}\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<!-- ======================================================\n     SHOP BY RESULT\n====================================================== -->\n\n<section\n  class=\"uf2-section uf2-results\"\n  id=\"uf2-results\">\n\n  <div class=\"uf2-container\">\n\n    <div class=\"uf2-kicker\">\n      Shop by result\n    </div>\n\n    <h2 class=\"uf2-title\">\n      What do you want to fix?\n    </h2>\n\n\n    <div class=\"uf2-result-grid\">\n\n      <a href=\"/collections/face\"\n        class=\"uf2-result-card\">\n\n        <div class=\"uf2-result-media\">\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0809/1985/5353/files/sh1.png?v=1790574140\"\n            alt=\"Face\"\n            loading=\"lazy\">\n\n        </div>\n\n        <div class=\"uf2-result-info\">\n          <small>Face</small>\n          <h3>Sharper face</h3>\n          <p>Blur + matte →</p>\n        </div>\n\n      </a>\n\n\n      <a href=\"/collections/hair\"\n        class=\"uf2-result-card\">\n\n        <div class=\"uf2-result-media\">\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0809/1985/5353/files/sh6.png?v=1790579884\"\n            alt=\"Hair\"\n            loading=\"lazy\">\n\n        </div>\n\n        <div class=\"uf2-result-info\">\n          <small>Hair</small>\n          <h3>Bouncier hair</h3>\n          <p>Bounce + hold →</p>\n        </div>\n\n      </a>\n\n\n      <a href=\"/collections/body\"\n        class=\"uf2-result-card\">\n\n        <div class=\"uf2-result-media\">\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0809/1985/5353/files/sh8.png?v=1790580282\"\n            alt=\"Body\"\n            loading=\"lazy\">\n\n        </div>\n\n        <div class=\"uf2-result-info\">\n          <small>Body</small>\n          <h3>Fresher body</h3>\n          <p>Fresh + clean →</p>\n        </div>\n\n      </a>\n\n\n      <a href=\"/collections/fragrance\"\n        class=\"uf2-result-card\">\n\n        <div class=\"uf2-result-media\">\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0809/1985/5353/files/Untitled_Design_69.png?v=1790578070\"\n            alt=\"Fragrance\"\n            loading=\"lazy\">\n\n        </div>\n\n        <div class=\"uf2-result-info\">\n          <small>Fragrance</small>\n          <h3>Get noticed</h3>\n          <p>Fresh scent →</p>\n        </div>\n\n      </a>\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<!-- ======================================================\n     ALL PRODUCTS\n====================================================== -->\n\n<section\n  class=\"uf2-section uf2-all-products uf2-divider\"\n  id=\"uf2-all\">\n\n  <div class=\"uf2-container\">\n\n    <div class=\"uf2-header-row\">\n\n      <div>\n\n        <div class=\"uf2-kicker\">\n          All products\n        </div>\n\n        <h2 class=\"uf2-title\">\n          The full advantage.\n        </h2>\n\n      </div>\n\n    </div>\n\n\n    <div\n      class=\"uf2-products\"\n      id=\"uf2ProductGrid\">\n\n\n      {% for product in collection.products %}\n\n        {% assign uf_category = 'all' %}\n\n        {% for tag in product.tags %}\n\n          {% assign clean_tag = tag | downcase %}\n\n          {% if clean_tag == 'face' %}\n            {% assign uf_category = 'face' %}\n          {% elsif clean_tag == 'hair' %}\n            {% assign uf_category = 'hair' %}\n          {% elsif clean_tag == 'body' %}\n            {% assign uf_category = 'body' %}\n          {% elsif clean_tag == 'fragrance' %}\n            {% assign uf_category = 'fragrance' %}\n          {% endif %}\n\n        {% endfor %}\n\n\n        <article\n          class=\"uf2-product uf2-filter-product\"\n          data-category=\"{{ uf_category }}\"\n          data-price=\"{{ product.price }}\"\n          data-title=\"{{ product.title | escape }}\"\n          data-original=\"{{ forloop.index }}\">\n\n\n          <a\n            href=\"{{ product.url }}\"\n            class=\"uf2-product-media\">\n\n\n            {% if product.featured_image %}\n\n              {{\n                product.featured_image\n                | image_url: width: 800\n                | image_tag:\n                  loading: 'lazy',\n                  widths: '300,400,500,600,700,800',\n                  sizes: '(max-width: 640px) 50vw, (max-width: 989px) 50vw, 25vw',\n                  alt: product.title\n              }}\n\n            {% endif %}\n\n          </a>\n\n\n          <div class=\"uf2-product-info\">\n\n            <h3 class=\"uf2-product-name\">\n\n              <a href=\"{{ product.url }}\">\n                {{ product.title }}\n              </a>\n\n            </h3>\n\n\n            <p class=\"uf2-product-benefit\">\n\n              {% if product.metafields.custom.short_benefit != blank %}\n\n                {{ product.metafields.custom.short_benefit }}\n\n              {% elsif product.description != blank %}\n\n                {{ product.description | strip_html | truncate: 80 }}\n\n              {% else %}\n\n                More results. Less effort.\n\n              {% endif %}\n\n            </p>\n\n\n            <div class=\"uf2-stars\">\n              ★★★★★\n            </div>\n\n\n            <div class=\"uf2-product-footer\">\n\n              <span class=\"uf2-price\">\n                {{ product.price | money }}\n              </span>\n\n              <a\n                href=\"{{ product.url }}\"\n                class=\"uf2-shop-link\">\n                Shop →\n              </a>\n\n            </div>\n\n          </div>\n\n        </article>\n\n      {% endfor %}\n\n    </div>\n\n\n    {% if collection.products_count > 12 %}\n\n      <div class=\"uf2-load\">\n\n        <a\n          href=\"{{ collection.url }}\"\n          class=\"uf2-outline-button\">\n          Load more\n        </a>\n\n      </div>\n\n    {% endif %}\n\n  </div>\n\n</section>\n\n\n<!-- ======================================================\n     WHY UNFAIR\n====================================================== -->\n\n<section class=\"uf2-section uf2-why uf2-divider\">\n\n  <div class=\"uf2-container uf2-why-grid\">\n\n    <div>\n\n      <div class=\"uf2-kicker\">\n        Why unfair?\n      </div>\n\n      <h2 class=\"uf2-title uf2-why-title\">\n        Not just<br>\n        grooming.\n\n        <em>\n          Your advantage.\n        </em>\n      </h2>\n\n\n      <p class=\"uf2-copy\">\n        One product. Multiple advantages.\n        Immediate visual payoff backed by\n        longer-term care.\n      </p>\n\n\n      <div class=\"uf2-benefits\">\n\n        <div class=\"uf2-benefit\">\n\n          <small>01</small>\n\n          <h3>\n            Instant performance\n          </h3>\n\n          <p>\n            Look sharper, fresher and more\n            put-together now.\n          </p>\n\n        </div>\n\n\n        <div class=\"uf2-benefit\">\n\n          <small>02</small>\n\n          <h3>\n            Long-term care\n          </h3>\n\n          <p>\n            High-performance ingredients designed\n            to keep delivering benefits.\n          </p>\n\n        </div>\n\n      </div>\n\n    </div>\n\n\n    <div class=\"uf2-why-art\">\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0809/1985/5353/files/Untitled_Design_69.png?v=1790578070\"\n        alt=\"UNFAIR product campaign\"\n        loading=\"lazy\">\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<!-- ======================================================\n     SOCIAL PROOF\n====================================================== -->\n\n<section class=\"uf2-section uf2-proof uf2-divider\">\n\n  <div class=\"uf2-container\">\n\n    <div class=\"uf2-header-row\">\n\n      <div>\n\n        <div class=\"uf2-kicker\">\n          Social proof\n        </div>\n\n        <h2 class=\"uf2-title\">\n          They noticed.\n        </h2>\n\n      </div>\n\n    </div>\n\n\n    <div class=\"uf2-review-grid\">\n\n      <article class=\"uf2-review\">\n\n        <div class=\"uf2-review-stars\">\n          ★★★★★\n        </div>\n\n        <blockquote>\n          “Works fast.”\n        </blockquote>\n\n        <div class=\"uf2-review-author\">\n          Verified buyer\n        </div>\n\n      </article>\n\n\n      <article class=\"uf2-review\">\n\n        <div class=\"uf2-review-stars\">\n          ★★★★★\n        </div>\n\n        <blockquote>\n          “Looks better.”\n        </blockquote>\n\n        <div class=\"uf2-review-author\">\n          Verified buyer\n        </div>\n\n      </article>\n\n\n      <article class=\"uf2-review\">\n\n        <div class=\"uf2-review-stars\">\n          ★★★★★\n        </div>\n\n        <blockquote>\n          “Love it.”\n        </blockquote>\n\n        <div class=\"uf2-review-author\">\n          Verified buyer\n        </div>\n\n      </article>\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<!-- ======================================================\n     EDITORIAL\n====================================================== -->\n\n<section class=\"uf2-editorial uf2-divider\">\n\n  <div class=\"uf2-container\">\n\n    <div class=\"uf2-editorial-heading\">\n\n      <div class=\"uf2-kicker\">\n        Unfair in real life\n      </div>\n\n      <h2 class=\"uf2-title\">\n        Look like you mean it.\n      </h2>\n\n      <p class=\"uf2-copy\">\n        Good looks are social.\n      </p>\n\n    </div>\n\n\n    <div class=\"uf2-editorial-art\">\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0809/1985/5353/files/sh11.png?v=1790582570\"\n        alt=\"UNFAIR editorial campaign\"\n        loading=\"lazy\">\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<!-- ======================================================\n     FINAL\n====================================================== -->\n\n<section class=\"uf2-final\">\n\n  <div class=\"uf2-container\">\n\n    <h2 class=\"uf2-final-title\">\n      The world isn't fair.<br>\n      Good.<br>\n      Neither are we.\n    </h2>\n\n    <div class=\"uf2-final-button\">\n\n      <a\n        href=\"/collections/all\"\n        class=\"uf2-button\">\n        Shop now →\n      </a>\n\n    </div>\n\n  </div>\n\n</section>\n\n\n</div>\n\n\n<script>\n\ndocument.addEventListener('DOMContentLoaded', function () {\n\n  const root =\n    document.getElementById('ufCollectionV2');\n\n  if (!root) return;\n\n\n  /* =====================================================\n     FILTER PRODUCTS\n  ===================================================== */\n\n  const filterButtons =\n    Array.from(\n      root.querySelectorAll('.uf2-filter-btn')\n    );\n\n  const products =\n    Array.from(\n      root.querySelectorAll('.uf2-filter-product')\n    );\n\n\n  filterButtons.forEach(function(button) {\n\n    button.addEventListener('click', function() {\n\n      const filter =\n        button.dataset.filter;\n\n\n      filterButtons.forEach(function(item) {\n        item.classList.remove('is-active');\n      });\n\n\n      button.classList.add('is-active');\n\n\n      products.forEach(function(product) {\n\n        const category =\n          product.dataset.category;\n\n        if (\n          filter === 'all' ||\n          category === filter\n        ) {\n\n          product.hidden = false;\n\n        } else {\n\n          product.hidden = true;\n\n        }\n\n      });\n\n    });\n\n  });\n\n\n  /* =====================================================\n     SORT PRODUCTS\n  ===================================================== */\n\n  const grid =\n    root.querySelector('#uf2ProductGrid');\n\n  const sort =\n    root.querySelector('#uf2Sort');\n\n\n  if (grid && sort) {\n\n    sort.addEventListener('change', function() {\n\n      const mode =\n        sort.value;\n\n\n      const items =\n        Array.from(\n          grid.querySelectorAll('.uf2-filter-product')\n        );\n\n\n      if (mode === 'price-low') {\n\n        items.sort(function(a,b) {\n\n          return (\n            Number(a.dataset.price) -\n            Number(b.dataset.price)\n          );\n\n        });\n\n      }\n\n\n      else if (mode === 'price-high') {\n\n        items.sort(function(a,b) {\n\n          return (\n            Number(b.dataset.price) -\n            Number(a.dataset.price)\n          );\n\n        });\n\n      }\n\n\n      else if (mode === 'az') {\n\n        items.sort(function(a,b) {\n\n          return (\n            a.dataset.title || ''\n          ).localeCompare(\n            b.dataset.title || ''\n          );\n\n        });\n\n      }\n\n\n      else {\n\n        items.sort(function(a,b) {\n\n          return (\n            Number(a.dataset.original) -\n            Number(b.dataset.original)\n          );\n\n        });\n\n      }\n\n\n      items.forEach(function(item) {\n        grid.appendChild(item);\n      });\n\n    });\n\n  }\n\n});\n\n</script>",
