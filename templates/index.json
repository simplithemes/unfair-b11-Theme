        "custom_liquid": "{% comment %}\nUN-FAIR — SECTION 02: THE UN-FAIR ADVANTAGE\nShopify Colourblock — Custom Liquid\nPaste directly below the Hero section.\n{% endcomment %}\n\n<style>\n#uf-advantage{\n  --ivory:#F5F0EC;\n  --charcoal:#1C1C1B;\n  --terra:#B76B56;\n  --line:rgba(28,28,27,.15);\n  width:100%;\n  background:var(--ivory);\n  color:var(--charcoal);\n  overflow:hidden;\n  font-family:inherit;\n}\n#uf-advantage *{box-sizing:border-box}\n\n.ufa-intro{\n  padding:clamp(80px,9vw,145px) clamp(20px,5vw,80px) clamp(70px,8vw,115px);\n  border-bottom:1px solid var(--line);\n}\n.ufa-inner{max-width:1500px;margin:0 auto}\n.ufa-kicker{\n  display:flex;align-items:center;gap:13px;margin:0 0 32px;\n  color:var(--terra);font-size:10px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;\n}\n.ufa-kicker span{\n  width:28px;height:28px;border:1px solid var(--terra);border-radius:50%;\n  display:inline-flex;align-items:center;justify-content:center;\n  font-size:8px;letter-spacing:0;\n}\n.ufa-headline{\n  margin:0;max-width:1350px;color:var(--charcoal);\n  font-size:clamp(52px,7.1vw,118px);line-height:.89;\n  font-weight:500;letter-spacing:-.07em;text-transform:uppercase;\n}\n.ufa-headline .outline{\n  color:transparent;\n  -webkit-text-stroke:1.3px var(--charcoal);\n}\n.ufa-headline em{color:var(--terra);font-weight:inherit}\n.ufa-intro-bottom{\n  margin-top:48px;display:flex;justify-content:space-between;align-items:flex-end;gap:35px;\n}\n.ufa-intro-copy{\n  max-width:430px;margin:0;color:rgba(28,28,27,.65);\n  font-size:13px;line-height:1.6;\n}\n.ufa-intro-note{\n  color:rgba(28,28,27,.48);font-size:9px;font-weight:700;\n  letter-spacing:.17em;line-height:1.55;text-align:right;text-transform:uppercase;\n}\n\n.ufa-panels{display:grid;grid-template-columns:1fr 1fr}\n.ufa-panel{\n  min-height:590px;padding:clamp(45px,5vw,78px);\n  display:flex;flex-direction:column;justify-content:space-between;\n}\n.ufa-instant{background:var(--terra);color:var(--ivory)}\n.ufa-lasting{background:var(--charcoal);color:var(--ivory)}\n.ufa-panel-top{\n  display:flex;justify-content:space-between;align-items:center;\n  padding-bottom:17px;border-bottom:1px solid rgba(245,240,236,.3);\n  color:rgba(245,240,236,.68);font-size:9px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;\n}\n.ufa-arrow{font-size:20px;font-weight:300}\n.ufa-panel-content{padding:55px 0}\n.ufa-eyebrow{\n  margin:0 0 18px;color:rgba(245,240,236,.7);\n  font-size:9px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;\n}\n.ufa-title{\n  margin:0;color:inherit;font-size:clamp(54px,6vw,96px);\n  line-height:.88;font-weight:500;letter-spacing:-.07em;text-transform:uppercase;\n}\n.ufa-title em{font-weight:inherit}\n.ufa-description{\n  max-width:430px;margin:27px 0 0;color:rgba(245,240,236,.8);\n  font-size:13px;line-height:1.62;\n}\n.ufa-tags{display:flex;flex-wrap:wrap;gap:7px}\n.ufa-tag{\n  padding:9px 13px;border:1px solid rgba(245,240,236,.36);\n  border-radius:999px;color:var(--ivory);font-size:8px;font-weight:700;\n  letter-spacing:.13em;text-transform:uppercase;\n}\n\n.ufa-payoff{\n  padding:clamp(75px,8vw,125px) 20px;\n  background:var(--ivory);text-align:center;\n}\n.ufa-payoff-label{\n  margin:0 0 18px;color:var(--terra);font-size:9px;font-weight:700;\n  letter-spacing:.22em;text-transform:uppercase;\n}\n.ufa-payoff-title{\n  margin:0 auto;color:var(--charcoal);font-size:clamp(44px,6vw,94px);\n  line-height:.92;font-weight:500;letter-spacing:-.065em;text-transform:uppercase;\n}\n.ufa-payoff-title em{color:var(--terra);font-weight:inherit}\n.ufa-payoff-copy{\n  max-width:450px;margin:23px auto 0;color:rgba(28,28,27,.6);\n  font-size:12px;line-height:1.6;\n}\n\n@media(max-width:749px){\n  .ufa-intro{padding:70px 20px 60px}\n  .ufa-kicker{font-size:8px;margin-bottom:25px}\n  .ufa-kicker span{width:25px;height:25px}\n  .ufa-headline{font-size:clamp(47px,14.7vw,69px);line-height:.9}\n  .ufa-headline .outline{-webkit-text-stroke:1px var(--charcoal)}\n  .ufa-intro-bottom{margin-top:34px;display:block}\n  .ufa-intro-copy{max-width:330px;font-size:12px;line-height:1.55}\n  .ufa-intro-note{display:none}\n  .ufa-panels{grid-template-columns:1fr}\n  .ufa-panel{min-height:520px;padding:34px 20px 38px}\n  .ufa-panel-content{padding:50px 0 45px}\n  .ufa-title{font-size:clamp(57px,17vw,80px)}\n  .ufa-description{max-width:340px;margin-top:23px;font-size:12px;line-height:1.55}\n  .ufa-tag{padding:8px 11px;font-size:7.5px}\n  .ufa-payoff{padding:75px 20px}\n  .ufa-payoff-title{font-size:clamp(45px,13.5vw,66px)}\n  .ufa-payoff-copy{max-width:310px;font-size:11.5px}\n}\n</style>\n\n<section id=\"uf-advantage\">\n\n  <div class=\"ufa-intro\">\n    <div class=\"ufa-inner\">\n\n      <div class=\"ufa-kicker\">\n        <span>02</span>\n        THE UN-FAIR ADVANTAGE\n      </div>\n\n      <h2 class=\"ufa-headline\">\n        ONE PRODUCT.<br>\n        <span class=\"outline\">MULTIPLE</span><br>\n        <em>ADVANTAGES.</em>\n      </h2>\n\n      <div class=\"ufa-intro-bottom\">\n        <p class=\"ufa-intro-copy\">\n          Why use three products when one can do more?\n          UN-FAIR is built for maximum output with minimum effort.\n        </p>\n\n        <div class=\"ufa-intro-note\">\n          MULTIPURPOSE BEAUTY<br>\n          MAXIMUM OUTPUT\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n  <div class=\"ufa-panels\">\n\n    <div class=\"ufa-panel ufa-instant\">\n\n      <div class=\"ufa-panel-top\">\n        <span>01 / IMMEDIATE</span>\n        <span class=\"ufa-arrow\">↗</span>\n      </div>\n\n      <div class=\"ufa-panel-content\">\n        <p class=\"ufa-eyebrow\">YOU USE IT → YOU LOOK BETTER.</p>\n\n        <h3 class=\"ufa-title\">\n          INSTANT<br>\n          <em>UPLIFT.</em>\n        </h3>\n\n        <p class=\"ufa-description\">\n          The immediate visual transformation. Built to make you look sharper,\n          fresher, more defined and more put-together — now.\n        </p>\n      </div>\n\n      <div class=\"ufa-tags\">\n        <span class=\"ufa-tag\">BLUR</span>\n        <span class=\"ufa-tag\">GLOW</span>\n        <span class=\"ufa-tag\">VOLUME</span>\n        <span class=\"ufa-tag\">DEFINITION</span>\n        <span class=\"ufa-tag\">EVENNESS</span>\n        <span class=\"ufa-tag\">FRESHNESS</span>\n        <span class=\"ufa-tag\">GROOMING</span>\n      </div>\n\n    </div>\n\n    <div class=\"ufa-panel ufa-lasting\">\n\n      <div class=\"ufa-panel-top\">\n        <span>02 / OVER TIME</span>\n        <span class=\"ufa-arrow\">↗</span>\n      </div>\n\n      <div class=\"ufa-panel-content\">\n        <p class=\"ufa-eyebrow\">BECAUSE THE FIRST IMPRESSION ISN'T ENOUGH.</p>\n\n        <h3 class=\"ufa-title\">\n          LASTING<br>\n          <em>EDGE.</em>\n        </h3>\n\n        <p class=\"ufa-description\">\n          More than cosmetic camouflage. High-performance skin and hair benefits\n          are built in to support how you look over time.\n        </p>\n      </div>\n\n      <div class=\"ufa-tags\">\n        <span class=\"ufa-tag\">PIGMENTATION</span>\n        <span class=\"ufa-tag\">PORES</span>\n        <span class=\"ufa-tag\">GLOW</span>\n        <span class=\"ufa-tag\">SKIN QUALITY</span>\n        <span class=\"ufa-tag\">BARRIER SUPPORT</span>\n        <span class=\"ufa-tag\">HAIR VOLUME</span>\n        <span class=\"ufa-tag\">HAIR CARE</span>\n      </div>\n\n    </div>\n\n  </div>\n\n  <div class=\"ufa-payoff\">\n\n    <p class=\"ufa-payoff-label\">THE WHOLE POINT</p>\n\n    <h3 class=\"ufa-payoff-title\">\n      LOOKS GOOD NOW.<br>\n      <em>GETS BETTER</em> OVER TIME.\n    </h3>\n\n    <p class=\"ufa-payoff-copy\">\n      Immediate payoff. Long-term benefits.\n      An unfair amount of output for the effort you put in.\n    </p>\n\n  </div>\n\n</section>",
