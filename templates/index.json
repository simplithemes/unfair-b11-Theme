      "settings": {
        "custom_liquid": "{% comment %}\nUN-FAIR — SECTION 03: SHOP THE ADVANTAGE\nShopify Colourblock — Custom Liquid\n\nIMPORTANT:\nChange the collection handle below if your collection is not /collections/all.\nCurrently this dynamically uses: collections['all']\n{% endcomment %}\n\n{% assign uf_collection = collections['all'] %}\n\n<style>\n#uf-shop{\n  --ivory:#F5F0EC;\n  --charcoal:#1C1C1B;\n  --terra:#B76B56;\n  --line:rgba(28,28,27,.15);\n  width:100%;\n  background:var(--ivory);\n  color:var(--charcoal);\n  overflow:hidden;\n  font-family:inherit;\n}\n#uf-shop *{box-sizing:border-box}\n\n/* Colourblock theme override: prevent inherited theme heading/link blue */\n#uf-shop h1,#uf-shop h2,#uf-shop h3,#uf-shop h4,#uf-shop h5,#uf-shop h6{\n  color:#1C1C1B !important;\n}\n#uf-shop a,#uf-shop a:visited{\n  color:#1C1C1B !important;\n}\n#uf-shop .ufs-kicker,\n#uf-shop .ufs-kicker span,\n#uf-shop .ufs-title em,\n#uf-shop .ufs-manifesto-small,\n#uf-shop .ufs-manifesto-title em{\n  color:#B76B56 !important;\n}\n#uf-shop .ufs-manifesto,\n#uf-shop .ufs-manifesto h1,\n#uf-shop .ufs-manifesto h2,\n#uf-shop .ufs-manifesto h3,\n#uf-shop .ufs-manifesto h4,\n#uf-shop .ufs-manifesto h5,\n#uf-shop .ufs-manifesto h6{\n  color:#F5F0EC !important;\n}\n#uf-shop .ufs-manifesto-title em{\n  color:#B76B56 !important;\n}\n#uf-shop .ufs-manifesto-link,\n#uf-shop .ufs-manifesto-link:visited{\n  color:#F5F0EC !important;\n}\n#uf-shop .ufs-product-title,\n#uf-shop .ufs-price{\n  color:#1C1C1B !important;\n}\n#uf-shop .ufs-tag,\n#uf-shop .ufs-badge,\n#uf-shop .ufs-quick{\n  color:#F5F0EC !important;\n}\n#uf-shop a{text-decoration:none;color:inherit}\n\n.ufs-wrap{\n  max-width:1600px;\n  margin:0 auto;\n  padding:clamp(75px,8vw,125px) clamp(18px,4vw,64px);\n}\n\n.ufs-head{\n  display:grid;\n  grid-template-columns:1fr auto;\n  align-items:end;\n  gap:40px;\n  padding-bottom:34px;\n  border-bottom:1px solid var(--line);\n}\n.ufs-kicker{\n  display:flex;\n  align-items:center;\n  gap:12px;\n  margin:0 0 24px;\n  color:var(--terra);\n  font-size:9px;\n  font-weight:700;\n  letter-spacing:.2em;\n  text-transform:uppercase;\n}\n.ufs-kicker span{\n  width:27px;height:27px;\n  display:inline-flex;align-items:center;justify-content:center;\n  border:1px solid var(--terra);border-radius:50%;\n  font-size:8px;letter-spacing:0;\n}\n.ufs-title{\n  margin:0;\n  max-width:850px;\n  color:var(--charcoal);\n  font-size:clamp(48px,6vw,92px);\n  line-height:.9;\n  font-weight:500;\n  letter-spacing:-.065em;\n  text-transform:uppercase;\n}\n.ufs-title em{color:var(--terra);font-weight:inherit}\n.ufs-viewall{\n  display:inline-flex;\n  align-items:center;\n  gap:14px;\n  padding:0 0 7px;\n  border-bottom:1px solid var(--terra);\n  font-size:9px;\n  font-weight:700;\n  letter-spacing:.16em;\n  text-transform:uppercase;\n  white-space:nowrap;\n}\n.ufs-viewall span{font-size:17px;font-weight:300;transition:transform .25s ease}\n.ufs-viewall:hover span{transform:translateX(5px)}\n\n.ufs-grid{\n  display:grid;\n  grid-template-columns:repeat(4,minmax(0,1fr));\n  gap:2px;\n  margin-top:2px;\n  background:var(--line);\n  border:1px solid var(--line);\n}\n\n.ufs-card{\n  min-width:0;\n  background:var(--ivory);\n  position:relative;\n}\n.ufs-media{\n  position:relative;\n  aspect-ratio:4/5;\n  overflow:hidden;\n  background:#ebe5e0;\n}\n.ufs-media img{\n  display:block;\n  width:100%;\n  height:100%;\n  object-fit:cover;\n  transition:transform .7s cubic-bezier(.22,.61,.36,1),opacity .35s ease;\n}\n.ufs-image-secondary{\n  position:absolute;\n  inset:0;\n  opacity:0;\n}\n.ufs-card:hover .ufs-image-primary{transform:scale(1.035)}\n.ufs-card:hover .ufs-image-secondary{opacity:1;transform:scale(1.02)}\n\n.ufs-badge{\n  position:absolute;\n  z-index:3;\n  left:14px;\n  top:14px;\n  padding:8px 10px;\n  background:var(--terra);\n  color:var(--ivory);\n  font-size:7px;\n  line-height:1;\n  font-weight:700;\n  letter-spacing:.14em;\n  text-transform:uppercase;\n}\n\n.ufs-quick{\n  position:absolute;\n  z-index:4;\n  left:14px;\n  right:14px;\n  bottom:14px;\n  min-height:46px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  background:var(--charcoal);\n  color:var(--ivory)!important;\n  font-size:8px;\n  font-weight:700;\n  letter-spacing:.16em;\n  text-transform:uppercase;\n  opacity:0;\n  transform:translateY(8px);\n  transition:.3s ease;\n}\n.ufs-card:hover .ufs-quick{\n  opacity:1;\n  transform:translateY(0);\n}\n.ufs-quick:hover{background:var(--terra)}\n\n.ufs-info{\n  padding:20px 17px 24px;\n}\n.ufs-product-top{\n  display:flex;\n  align-items:flex-start;\n  justify-content:space-between;\n  gap:14px;\n}\n.ufs-product-title{\n  margin:0;\n  color:var(--charcoal);\n  font-size:14px;\n  line-height:1.25;\n  font-weight:600;\n  letter-spacing:-.015em;\n}\n.ufs-price{\n  flex-shrink:0;\n  color:var(--charcoal);\n  font-size:12px;\n  line-height:1.25;\n  font-weight:700;\n}\n.ufs-compare{\n  margin-left:5px;\n  color:rgba(28,28,27,.42);\n  text-decoration:line-through;\n  font-weight:400;\n}\n.ufs-micro{\n  margin:12px 0 0;\n  color:rgba(28,28,27,.53);\n  font-size:9px;\n  line-height:1.4;\n  font-weight:600;\n  letter-spacing:.11em;\n  text-transform:uppercase;\n}\n\n.ufs-empty{\n  grid-column:1/-1;\n  padding:70px 25px;\n  background:var(--ivory);\n  text-align:center;\n}\n.ufs-empty strong{\n  display:block;\n  font-size:30px;\n  letter-spacing:-.04em;\n  margin-bottom:10px;\n}\n.ufs-empty p{\n  margin:0;\n  color:rgba(28,28,27,.6);\n  font-size:13px;\n}\n\n.ufs-manifesto{\n  margin-top:2px;\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  background:var(--charcoal);\n  color:var(--ivory);\n}\n.ufs-manifesto-left{\n  padding:clamp(42px,5vw,75px);\n  border-right:1px solid rgba(245,240,236,.18);\n}\n.ufs-manifesto-small{\n  margin:0 0 18px;\n  color:var(--terra);\n  font-size:9px;\n  font-weight:700;\n  letter-spacing:.2em;\n  text-transform:uppercase;\n}\n.ufs-manifesto-title{\n  margin:0;\n  max-width:650px;\n  font-size:clamp(37px,4.4vw,68px);\n  line-height:.94;\n  font-weight:500;\n  letter-spacing:-.055em;\n  text-transform:uppercase;\n}\n.ufs-manifesto-title em{color:var(--terra);font-weight:inherit}\n.ufs-manifesto-right{\n  padding:clamp(42px,5vw,75px);\n  display:flex;\n  flex-direction:column;\n  justify-content:flex-end;\n}\n.ufs-manifesto-copy{\n  max-width:440px;\n  margin:0;\n  color:rgba(245,240,236,.72);\n  font-size:13px;\n  line-height:1.65;\n}\n.ufs-manifesto-link{\n  width:max-content;\n  margin-top:28px;\n  padding-bottom:6px;\n  border-bottom:1px solid var(--terra);\n  color:var(--ivory)!important;\n  font-size:9px;\n  font-weight:700;\n  letter-spacing:.16em;\n  text-transform:uppercase;\n}\n\n@media(max-width:989px){\n  .ufs-grid{grid-template-columns:repeat(2,minmax(0,1fr))}\n  .ufs-quick{opacity:1;transform:none;left:9px;right:9px;bottom:9px;min-height:42px}\n}\n@media(max-width:749px){\n  .ufs-wrap{padding:70px 14px}\n  .ufs-head{grid-template-columns:1fr;gap:25px;padding:0 5px 27px}\n  .ufs-kicker{margin-bottom:20px;font-size:8px}\n  .ufs-title{font-size:clamp(45px,13.7vw,64px)}\n  .ufs-viewall{width:max-content}\n  .ufs-grid{gap:1px}\n  .ufs-info{padding:15px 11px 18px}\n  .ufs-product-top{display:block}\n  .ufs-product-title{font-size:12px;min-height:30px}\n  .ufs-price{display:block;margin-top:8px;font-size:11px}\n  .ufs-micro{margin-top:9px;font-size:7px;letter-spacing:.09em}\n  .ufs-badge{left:8px;top:8px;padding:7px 8px;font-size:6px}\n  .ufs-quick{font-size:7px;letter-spacing:.12em}\n  .ufs-manifesto{grid-template-columns:1fr}\n  .ufs-manifesto-left{padding:45px 20px;border-right:0;border-bottom:1px solid rgba(245,240,236,.18)}\n  .ufs-manifesto-right{padding:40px 20px 46px}\n  .ufs-manifesto-title{font-size:clamp(39px,12vw,58px)}\n  .ufs-manifesto-copy{font-size:12px}\n}\n</style>\n\n<section id=\"uf-shop\">\n  <div class=\"ufs-wrap\">\n\n    <div class=\"ufs-head\">\n      <div>\n        <div class=\"ufs-kicker\">\n          <span>03</span>\n          SHOP THE ADVANTAGE\n        </div>\n\n        <h2 class=\"ufs-title\">\n          MORE OUTPUT.<br>\n          <em>LESS EFFORT.</em>\n        </h2>\n      </div>\n\n      <a class=\"ufs-viewall\" href=\"{{ uf_collection.url | default: '/collections/all' }}\">\n        VIEW EVERYTHING <span>→</span>\n      </a>\n    </div>\n\n    <div class=\"ufs-grid\">\n\n      {% if uf_collection != blank and uf_collection.products_count > 0 %}\n\n        {% for product in uf_collection.products limit: 4 %}\n\n          <article class=\"ufs-card\">\n\n            <a href=\"{{ product.url }}\" aria-label=\"{{ product.title | escape }}\">\n\n              <div class=\"ufs-media\">\n\n                {% if product.featured_image != blank %}\n                  {{\n                    product.featured_image\n                    | image_url: width: 900\n                    | image_tag:\n                      class: 'ufs-image-primary',\n                      loading: 'lazy',\n                      widths: '300, 450, 600, 750, 900',\n                      sizes: '(max-width: 749px) 50vw, 25vw',\n                      alt: product.title\n                  }}\n                {% endif %}\n\n                {% if product.images.size > 1 %}\n                  {{\n                    product.images[1]\n                    | image_url: width: 900\n                    | image_tag:\n                      class: 'ufs-image-secondary',\n                      loading: 'lazy',\n                      widths: '300, 450, 600, 750, 900',\n                      sizes: '(max-width: 749px) 50vw, 25vw',\n                      alt: product.title\n                  }}\n                {% endif %}\n\n                {% if product.compare_at_price > product.price %}\n                  <div class=\"ufs-badge\">UNFAIR PRICE</div>\n                {% elsif forloop.first %}\n                  <div class=\"ufs-badge\">THE FAVOURITE</div>\n                {% endif %}\n\n                <span class=\"ufs-quick\">\n                  VIEW THE ADVANTAGE →\n                </span>\n\n              </div>\n\n              <div class=\"ufs-info\">\n\n                <div class=\"ufs-product-top\">\n\n                  <h3 class=\"ufs-product-title\">\n                    {{ product.title }}\n                  </h3>\n\n                  <div class=\"ufs-price\">\n                    {{ product.price | money }}\n\n                    {% if product.compare_at_price > product.price %}\n                      <span class=\"ufs-compare\">\n                        {{ product.compare_at_price | money }}\n                      </span>\n                    {% endif %}\n                  </div>\n\n                </div>\n\n                <p class=\"ufs-micro\">\n                  LOOKS GOOD NOW. WORKS BEYOND NOW.\n                </p>\n\n              </div>\n\n            </a>\n\n          </article>\n\n        {% endfor %}\n\n      {% else %}\n\n        <div class=\"ufs-empty\">\n          <strong>Your products will appear here.</strong>\n          <p>Add products to Shopify and this section will populate automatically.</p>\n        </div>\n\n      {% endif %}\n\n    </div>\n\n\n    <div class=\"ufs-manifesto\">\n\n      <div class=\"ufs-manifesto-left\">\n\n        <p class=\"ufs-manifesto-small\">\n          BEAUTY MATH, FIXED.\n        </p>\n\n        <h3 class=\"ufs-manifesto-title\">\n          WHY USE THREE<br>\n          WHEN <em>ONE</em><br>\n          DOES MORE?\n        </h3>\n\n      </div>\n\n      <div class=\"ufs-manifesto-right\">\n\n        <p class=\"ufs-manifesto-copy\">\n          Every UN-FAIR product is designed to earn its place.\n          Instant visual payoff, high-performance ingredients and\n          more than one advantage — without turning your routine\n          into a full-time job.\n        </p>\n\n        <a class=\"ufs-manifesto-link\" href=\"/collections/all\">\n          FIND YOUR ADVANTAGE →\n        </a>\n\n      </div>\n\n    </div>\n\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_xzL8Wx": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\nUN-FAIR — SECTION 04: BEAUTY FOR AN UNFAIR VISUAL ADVANTAGE\nShopify Colourblock — Custom Liquid\nUses the supplied UN-FAIR campaign imagery.\n{% endcomment %}\n\n<style>\n#uf-editorial-04{\n  --ivory:#F5F0EC;\n  --charcoal:#1C1C1B;\n  --terra:#B76B56;\n  width:100%;\n  margin:0;\n  background:#F5F0EC !important;\n  color:#1C1C1B !important;\n  overflow:hidden;\n  font-family:inherit;\n}\n#uf-editorial-04 *{box-sizing:border-box}\n#uf-editorial-04 h2,#uf-editorial-04 h3,#uf-editorial-04 p,#uf-editorial-04 span,#uf-editorial-04 a{\n  color:inherit;\n}\n#uf-editorial-04 a,#uf-editorial-04 a:visited{text-decoration:none}\n\n.ufe-grid{\n  display:grid;\n  grid-template-columns:54% 46%;\n  min-height:760px;\n}\n\n/* IMAGE SIDE */\n.ufe-visual{\n  position:relative;\n  min-height:760px;\n  overflow:hidden;\n  background:#ddd5cf;\n}\n.ufe-main{\n  position:absolute;inset:0;\n  width:100%;height:100%;\n  object-fit:cover;\n  display:block;\n  transition:transform 1.1s cubic-bezier(.22,.61,.36,1);\n}\n.ufe-visual:hover .ufe-main{transform:scale(1.025)}\n\n/* COPY SIDE */\n.ufe-copy{\n  position:relative;\n  display:flex;\n  flex-direction:column;\n  justify-content:space-between;\n  padding:clamp(55px,6vw,95px) clamp(28px,5vw,78px);\n  background:#B76B56 !important;\n  color:#F5F0EC !important;\n}\n.ufe-topline{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  padding-bottom:18px;\n  border-bottom:1px solid rgba(245,240,236,.35);\n  color:#F5F0EC !important;\n  font-size:9px;\n  font-weight:700;\n  letter-spacing:.18em;\n  text-transform:uppercase;\n}\n.ufe-body{padding:60px 0}\n.ufe-eyebrow{\n  margin:0 0 22px;\n  color:#F5F0EC !important;\n  opacity:.72;\n  font-size:9px;\n  font-weight:700;\n  letter-spacing:.2em;\n  text-transform:uppercase;\n}\n.ufe-title{\n  margin:0 !important;\n  color:#F5F0EC !important;\n  font-size:clamp(52px,5.7vw,94px);\n  line-height:.88;\n  font-weight:500;\n  letter-spacing:-.07em;\n  text-transform:uppercase;\n}\n.ufe-title em{\n  color:#1C1C1B !important;\n  font-weight:inherit;\n}\n.ufe-desc{\n  max-width:460px;\n  margin:30px 0 0;\n  color:rgba(245,240,236,.84) !important;\n  font-size:13px;\n  line-height:1.65;\n}\n.ufe-bottom{\n  display:flex;\n  align-items:flex-end;\n  justify-content:space-between;\n  gap:30px;\n}\n.ufe-link,.ufe-link:visited{\n  width:max-content;\n  display:inline-flex;\n  align-items:center;\n  gap:14px;\n  padding-bottom:7px;\n  border-bottom:1px solid #F5F0EC;\n  color:#F5F0EC !important;\n  font-size:9px;\n  font-weight:700;\n  letter-spacing:.16em;\n  text-transform:uppercase;\n}\n.ufe-link span{color:#F5F0EC !important;font-size:18px;transition:transform .25s ease}\n.ufe-link:hover span{transform:translateX(5px)}\n.ufe-note{\n  color:rgba(245,240,236,.66) !important;\n  font-size:8px;\n  line-height:1.5;\n  font-weight:700;\n  letter-spacing:.16em;\n  text-align:right;\n  text-transform:uppercase;\n}\n\n/* TICKER */\n.ufe-ticker{\n  overflow:hidden;\n  background:#1C1C1B !important;\n  color:#F5F0EC !important;\n  border-top:1px solid rgba(245,240,236,.15);\n}\n.ufe-track{\n  width:max-content;\n  display:flex;\n  align-items:center;\n  animation:ufeTicker 24s linear infinite;\n}\n.ufe-item{\n  display:flex;\n  align-items:center;\n  gap:25px;\n  padding:18px 22px;\n  color:#F5F0EC !important;\n  font-size:9px;\n  font-weight:700;\n  letter-spacing:.19em;\n  text-transform:uppercase;\n  white-space:nowrap;\n}\n.ufe-dot{\n  width:6px;height:6px;\n  border-radius:50%;\n  background:#B76B56;\n  flex:0 0 auto;\n}\n@keyframes ufeTicker{\n  from{transform:translateX(0)}\n  to{transform:translateX(-50%)}\n}\n\n@media(max-width:989px){\n  .ufe-grid{grid-template-columns:1fr;min-height:auto}\n  .ufe-visual{min-height:650px}\n  .ufe-copy{min-height:650px}\n}\n@media(max-width:749px){\n  .ufe-visual{min-height:520px}\n        .ufe-copy{min-height:570px;padding:36px 20px 42px}\n  .ufe-body{padding:52px 0}\n  .ufe-title{font-size:clamp(52px,15vw,72px)}\n  .ufe-desc{max-width:340px;font-size:12px;line-height:1.58}\n  .ufe-bottom{display:block}\n  .ufe-note{display:none}\n  .ufe-item{padding:16px 18px;font-size:8px}\n}\n@media(prefers-reduced-motion:reduce){\n  .ufe-track{animation:none}\n  .ufe-main{transition:none}\n}\n</style>\n\n<section id=\"uf-editorial-04\">\n\n  <div class=\"ufe-grid\">\n\n    <div class=\"ufe-visual\">\n      <img\n        class=\"ufe-main\"\n        src=\"https://cdn.shopify.com/s/files/1/0809/1985/5353/files/Untitled_Design_68.png?v=1790574691\"\n        alt=\"UN-FAIR beauty campaign\"\n        width=\"1200\"\n        height=\"1500\"\n        loading=\"lazy\"\n      >\n\n      <!-- Intentionally no text overlay on campaign image -->\n    </div>\n\n\n    <div class=\"ufe-copy\">\n\n      <div class=\"ufe-topline\">\n        <span>THE UN-FAIR EDGE</span>\n        <span>↗</span>\n      </div>\n\n      <div class=\"ufe-body\">\n\n        <p class=\"ufe-eyebrow\">\n          BEAUTY FOR AN UNFAIR VISUAL ADVANTAGE\n        </p>\n\n        <h2 class=\"ufe-title\">\n          LOOK<br>\n          BETTER.<br>\n          TRY <em>LESS.</em>\n        </h2>\n\n        <p class=\"ufe-desc\">\n          Looking more polished shouldn't require a ten-step routine.\n          UN-FAIR is designed to deliver the kind of visual upgrade people\n          notice — with less time, less effort and more confidence.\n        </p>\n\n      </div>\n\n      <div class=\"ufe-bottom\">\n\n        <a class=\"ufe-link\" href=\"/collections/all\">\n          GET THE EDGE <span>→</span>\n        </a>\n\n        <div class=\"ufe-note\">\n          INSTANT UPLIFT<br>\n          LONG-TERM EDGE\n        </div>\n\n      </div>\n\n    </div>\n\n  </div>\n\n\n  <div class=\"ufe-ticker\" aria-label=\"UN-FAIR brand benefits\">\n\n    <div class=\"ufe-track\">\n\n      <div class=\"ufe-item\"><span>LOOK SHARPER</span><i class=\"ufe-dot\"></i></div>\n      <div class=\"ufe-item\"><span>LOOK MORE GROOMED</span><i class=\"ufe-dot\"></i></div>\n      <div class=\"ufe-item\"><span>LOOK CAMERA-READY</span><i class=\"ufe-dot\"></i></div>\n      <div class=\"ufe-item\"><span>STAND OUT</span><i class=\"ufe-dot\"></i></div>\n      <div class=\"ufe-item\"><span>FEEL MORE CONFIDENT</span><i class=\"ufe-dot\"></i></div>\n      <div class=\"ufe-item\"><span>MORE RESULTS. LESS EFFORT.</span><i class=\"ufe-dot\"></i></div>\n\n      <div class=\"ufe-item\"><span>LOOK SHARPER</span><i class=\"ufe-dot\"></i></div>\n      <div class=\"ufe-item\"><span>LOOK MORE GROOMED</span><i class=\"ufe-dot\"></i></div>\n      <div class=\"ufe-item\"><span>LOOK CAMERA-READY</span><i class=\"ufe-dot\"></i></div>\n      <div class=\"ufe-item\"><span>STAND OUT</span><i class=\"ufe-dot\"></i></div>\n      <div class=\"ufe-item\"><span>FEEL MORE CONFIDENT</span><i class=\"ufe-dot\"></i></div>\n      <div class=\"ufe-item\"><span>MORE RESULTS. LESS EFFORT.</span><i class=\"ufe-dot\"></i></div>\n\n    </div>\n\n  </div>\n\n</section>",
        "color_scheme": "",
