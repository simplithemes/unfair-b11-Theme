        "custom_liquid": "{% comment %}\nUN-FAIR — SECTION 08: BRAND MANIFESTO\nShopify Colourblock — Custom Liquid\nNo imagery. Strong editorial brand statement before FAQ/newsletter.\n{% endcomment %}\n\n<style>\n#uf-manifesto-08{\n  --ivory:#F5F0EC;\n  --charcoal:#1C1C1B;\n  --terra:#B76B56;\n  --line:rgba(28,28,27,.15);\n  width:100%;\n  margin:0;\n  background:#F5F0EC !important;\n  color:#1C1C1B !important;\n  overflow:hidden;\n  font-family:inherit;\n}\n#uf-manifesto-08 *{box-sizing:border-box}\n#uf-manifesto-08 h2,#uf-manifesto-08 h3,#uf-manifesto-08 p,#uf-manifesto-08 span,#uf-manifesto-08 a{color:inherit}\n#uf-manifesto-08 a,#uf-manifesto-08 a:visited{text-decoration:none}\n\n.ufm-shell{\n  max-width:1600px;\n  margin:0 auto;\n  padding:clamp(80px,10vw,155px) clamp(18px,4vw,64px);\n}\n.ufm-top{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  gap:30px;\n  padding-bottom:35px;\n  border-bottom:1px solid var(--line);\n}\n.ufm-kicker{\n  display:flex;align-items:center;gap:12px;\n  margin:0;color:#B76B56 !important;\n  font-size:9px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;\n}\n.ufm-kicker span{\n  width:27px;height:27px;border:1px solid #B76B56;border-radius:50%;\n  display:inline-flex;align-items:center;justify-content:center;\n  color:#B76B56 !important;font-size:8px;letter-spacing:0;\n}\n.ufm-side{\n  color:rgba(28,28,27,.45) !important;\n  font-size:8px;font-weight:700;letter-spacing:.17em;text-transform:uppercase;\n}\n\n/* MAIN MANIFESTO */\n.ufm-main{\n  padding:clamp(60px,8vw,120px) 0;\n}\n.ufm-line{\n  display:block;\n  margin:0;\n  color:#1C1C1B !important;\n  font-size:clamp(52px,8vw,132px);\n  line-height:.86;\n  font-weight:500;\n  letter-spacing:-.075em;\n  text-transform:uppercase;\n}\n.ufm-line-outline{\n  color:transparent !important;\n  -webkit-text-stroke:1.35px #1C1C1B;\n}\n.ufm-line-terra{color:#B76B56 !important;font-style:italic}\n\n/* BOTTOM STORY */\n.ufm-bottom{\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  border-top:1px solid var(--line);\n}\n.ufm-column{\n  padding:45px 0 0;\n}\n.ufm-column:first-child{\n  padding-right:clamp(30px,6vw,95px);\n  border-right:1px solid var(--line);\n}\n.ufm-column:last-child{\n  padding-left:clamp(30px,6vw,95px);\n}\n.ufm-label{\n  margin:0 0 20px;\n  color:#B76B56 !important;\n  font-size:8px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;\n}\n.ufm-copy{\n  max-width:520px;\n  margin:0;\n  color:rgba(28,28,27,.68) !important;\n  font-size:13px;\n  line-height:1.72;\n}\n.ufm-promise{\n  max-width:550px;\n  margin:0 !important;\n  color:#1C1C1B !important;\n  font-size:clamp(27px,3vw,45px);\n  line-height:1.06;\n  font-weight:500;\n  letter-spacing:-.04em;\n}\n.ufm-promise em{color:#B76B56 !important;font-weight:inherit}\n.ufm-link,.ufm-link:visited{\n  width:max-content;\n  display:inline-flex;\n  align-items:center;\n  gap:14px;\n  margin-top:28px;\n  padding-bottom:7px;\n  border-bottom:1px solid #B76B56;\n  color:#1C1C1B !important;\n  font-size:9px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;\n}\n.ufm-link span{color:#B76B56 !important;font-size:18px}\n\n/* SIGN OFF */\n.ufm-signoff{\n  margin-top:clamp(70px,8vw,120px);\n  padding:24px 0;\n  border-top:1px solid var(--line);\n  border-bottom:1px solid var(--line);\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  gap:30px;\n}\n.ufm-signoff strong{\n  color:#1C1C1B !important;\n  font-size:10px;font-weight:700;letter-spacing:.17em;text-transform:uppercase;\n}\n.ufm-signoff span{\n  color:#B76B56 !important;\n  font-size:9px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;\n}\n\n@media(max-width:749px){\n  .ufm-shell{padding:72px 18px}\n  .ufm-top{padding-bottom:28px}\n  .ufm-kicker{font-size:8px}\n  .ufm-side{display:none}\n  .ufm-main{padding:60px 0}\n  .ufm-line{font-size:clamp(47px,15vw,70px);line-height:.89}\n  .ufm-line-outline{-webkit-text-stroke:1px #1C1C1B}\n  .ufm-bottom