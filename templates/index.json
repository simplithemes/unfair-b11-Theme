      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\nUN-FAIR — SECTION 05: PICK YOUR ADVANTAGE\nShopify Colourblock — Custom Liquid\nA text-led \"shop by result\" section to create breathing room after Section 04.\n{% endcomment %}\n\n<style>\n#uf-goals-05{\n  --ivory:#F5F0EC;\n  --charcoal:#1C1C1B;\n  --terra:#B76B56;\n  --line:rgba(28,28,27,.15);\n  width:100%;\n  margin:0;\n  background:#F5F0EC !important;\n  color:#1C1C1B !important;\n  font-family:inherit;\n}\n#uf-goals-05 *{box-sizing:border-box}\n#uf-goals-05 h2,#uf-goals-05 h3,#uf-goals-05 p,#uf-goals-05 span,#uf-goals-05 a{color:inherit}\n#uf-goals-05 a,#uf-goals-05 a:visited{text-decoration:none}\n\n.ufg-shell{\n  max-width:1600px;\n  margin:0 auto;\n  padding:clamp(78px,9vw,140px) clamp(18px,4vw,64px);\n}\n.ufg-header{\n  display:grid;\n  grid-template-columns:minmax(0,1fr) minmax(260px,420px);\n  align-items:end;\n  gap:60px;\n  padding-bottom:50px;\n}\n.ufg-kicker{\n  display:flex;align-items:center;gap:12px;\n  margin:0 0 25px;\n  color:#B76B56 !important;\n  font-size:9px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;\n}\n.ufg-kicker span{\n  width:27px;height:27px;border:1px solid #B76B56;border-radius:50%;\n  display:inline-flex;align-items:center;justify-content:center;\n  color:#B76B56 !important;font-size:8px;letter-spacing:0;\n}\n.ufg-title{\n  margin:0 !important;\n  color:#1C1C1B !important;\n  font-size:clamp(49px,6.4vw,100px);\n  line-height:.89;font-weight:500;letter-spacing:-.07em;text-transform:uppercase;\n}\n.ufg-title em{color:#B76B56 !important;font-weight:inherit}\n.ufg-intro{\n  margin:0 0 5px;\n  color:rgba(28,28,27,.62) !important;\n  font-size:13px;line-height:1.65;\n}\n\n/* RESULT ROWS */\n.ufg-list{\n  border-top:1px solid var(--line);\n}\n.ufg-row{\n  position:relative;\n  display:grid;\n  grid-template-columns:70px minmax(0,1fr) auto;\n  align-items:center;\n  gap:25px;\n  min-height:118px;\n  padding:18px 5px;\n  border-bottom:1px solid var(--line);\n  color:#1C1C1B !important;\n  overflow:hidden;\n  transition:padding .3s ease,color .3s ease;\n}\n.ufg-row:before{\n  content:\"\";\n  position:absolute;inset:0;\n  background:#1C1C1B;\n  transform:scaleY(0);\n  transform-origin:bottom;\n  transition:transform .35s cubic-bezier(.22,.61,.36,1);\n  z-index:0;\n}\n.ufg-row > *{position:relative;z-index:1}\n.ufg-row:hover:before{transform:scaleY(1)}\n.ufg-row:hover{padding-left:22px;padding-right:22px;color:#F5F0EC !important}\n\n.ufg-num{\n  color:#B76B56 !important;\n  font-size:9px;font-weight:700;letter-spacing:.14em;\n}\n.ufg-name{\n  margin:0 !important;\n  color:inherit !important;\n  font-size:clamp(35px,4vw,62px);\n  line-height:.95;font-weight:500;letter-spacing:-.055em;text-transform:uppercase;\n}\n.ufg-detail{\n  max-width:300px;\n  display:flex;align-items:center;justify-content:flex-end;gap:24px;\n}\n.ufg-detail p{\n  margin:0;\n  color:rgba(28,28,27,.55) !important;\n  font-size:10px;line-height:1.45;font-weight:600;\n  letter-spacing:.1em;text-align:right;text-transform:uppercase;\n  transition:color .3s ease;\n}\n.ufg-row:hover .ufg-detail p{color:rgba(245,240,236,.68) !important}\n.ufg-arrow{\n  width:42px;height:42px;border:1px solid rgba(28,28,27,.25);border-radius:50%;\n  display:flex;align-items:center;justify-content:center;\n  color:#1C1C1B !important;font-size:17px;\n  transition:.3s ease;\n}\n.ufg-row:hover .ufg-arrow{\n  border-color:#B76B56;\n  background:#B76B56;\n  color:#F5F0EC !important;\n  transform:rotate(-35deg);\n}\n\n/* FOOTER STATEMENT */\n.ufg-footer{\n  display:grid;\n  grid-template-columns:1fr auto;\n  align-items:center;\n  gap:30px;\n  padding-top:42px;\n}\n.ufg-footnote{\n  margin:0;\n  color:rgba(28,28,27,.5) !important;\n  font-size:9px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;\n}\n.ufg-all,.ufg-all:visited{\n  display:inline-flex;align-items:center;gap:14px;\n  padding-bottom:7px;border-bottom:1px solid #B76B56;\n  color:#1C1C1B !important;\n  font-size:9px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;\n}\n.ufg-all span{color:#B76B56 !important;font-size:18px}\n\n@media(max-width:749px){\n  .ufg-shell{padding:72px 18px}\n  .ufg-header{grid-template-columns:1fr;gap:28px;padding-bottom:38px}\n  .ufg-kicker{font-size:8px;margin-bottom:21px}\n  .ufg-title{font-size:clamp(47px,14.5vw,68px)}\n  .ufg-intro{max-width:330px;font-size:12px;line-height:1.58}\n  .ufg-row{\n    grid-template-columns:35px minmax(0,1fr) 36px;\n    gap:10px;min-height:91px;padding:14px 2px;\n  }\n  .ufg-row:hover{padding-left:10px;padding-right:10px}\n  .ufg-num{font-size:7px}\n  .ufg-name{font-size:clamp(29px,9vw,42px)}\n  .ufg-detail{display:block}\n  .ufg-detail p{display:none}\n  .ufg-arrow{width:34px;height:34px;font-size:14px}\n  .ufg-footer{grid-template-columns:1fr;gap:24px;padding-top:32px}\n  .ufg-footnote{font-size:8px;line-height:1.5}\n  .ufg-all{width:max-content}\n}\n</style>\n\n<section id=\"uf-goals-05\">\n  <div class=\"ufg-shell\">\n\n    <div class=\"ufg-header\">\n      <div>\n        <div class=\"ufg-kicker\">\n          <span>05</span>\n          PICK YOUR ADVANTAGE\n        </div>\n\n        <h2 class=\"ufg-title\">\n          WHAT DO YOU<br>\n          WANT TO <em>FIX?</em>\n        </h2>\n      </div>\n\n      <p class=\"ufg-intro\">\n        Start with the result, not the routine. Pick the upgrade you want\n        and find the UN-FAIR products designed to do more of the work for you.\n      </p>\n    </div>\n\n\n    <div class=\"ufg-list\">\n\n      <a class=\"ufg-row\" href=\"/collections/all\">\n        <span class=\"ufg-num\">01</span>\n        <h3 class=\"ufg-name\">GLOW</h3>\n        <div class=\"ufg-detail\">\n          <p>LOOK FRESHER.<br>FAST.</p>\n          <span class=\"ufg-arrow\">→</span>\n        </div>\n      </a>\n\n      <a class=\"ufg-row\" href=\"/collections/all\">\n        <span class=\"ufg-num\">02</span>\n        <h3 class=\"ufg-name\">BLUR + EVENNESS</h3>\n        <div class=\"ufg-detail\">\n          <p>SMOOTHER-LOOKING.<br>MORE PUT-TOGETHER.</p>\n          <span class=\"ufg-arrow\">→</span>\n        </div>\n      </a>\n\n      <a class=\"ufg-row\" href=\"/collections/all\">\n        <span class=\"ufg-num\">03</span>\n        <h3 class=\"ufg-name\">DEFINITION</h3>\n        <div class=\"ufg-detail\">\n          <p>SHARPER.<br>MORE POLISHED.</p>\n          <span class=\"ufg-arrow\">→</span>\n        </div>\n      </a>\n\n      <a class=\"ufg-row\" href=\"/collections/all\">\n        <span class=\"ufg-num\">04</span>\n        <h3 class=\"ufg-name\">VOLUME</h3>\n        <div class=\"ufg-detail\">\n          <p>MORE BODY.<br>LESS EFFORT.</p>\n          <span class=\"ufg-arrow\">→</span>\n        </div>\n      </a>\n\n      <a class=\"ufg-row\" href=\"/collections/all\">\n        <span class=\"ufg-num\">05</span>\n        <h3 class=\"ufg-name\">SKIN QUALITY</h3>\n        <div class=\"ufg-detail\">\n          <p>THE LONGER-TERM<br>EDGE.</p>\n          <span class=\"ufg-arrow\">→</span>\n        </div>\n      </a>\n\n      <a class=\"ufg-row\" href=\"/collections/all\">\n        <span class=\"ufg-num\">06</span>\n        <h3 class=\"ufg-name\">HAIR GAME</h3>\n        <div class=\"ufg-detail\">\n          <p>SET. VOLUME.<br>CARE.</p>\n          <span class=\"ufg-arrow\">→</span>\n        </div>\n      </a>\n\n    </div>\n\n\n    <div class=\"ufg-footer\">\n      <p class=\"ufg-footnote\">\n        ONE PRODUCT. MULTIPLE ADVANTAGES. THAT'S THE POINT.\n      </p>\n\n      <a class=\"ufg-all\" href=\"/collections/all\">\n        SHOP ALL UN-FAIR <span>→</span>\n      </a>\n    </div>\n\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
