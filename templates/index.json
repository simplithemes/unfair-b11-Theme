    "custom_liquid_EQEy7z": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\nUN-FAIR — SECTION 06: THE UN-FAIR FORMULA\nShopify Colourblock — Custom Liquid\nText-led performance section. No image overlays.\n{% endcomment %}\n\n<style>\n#uf-formula-06{\n  --ivory:#F5F0EC;\n  --charcoal:#1C1C1B;\n  --terra:#B76B56;\n  --line:rgba(245,240,236,.18);\n  width:100%;\n  margin:0;\n  background:#1C1C1B !important;\n  color:#F5F0EC !important;\n  overflow:hidden;\n  font-family:inherit;\n}\n#uf-formula-06 *{box-sizing:border-box}\n#uf-formula-06 h2,#uf-formula-06 h3,#uf-formula-06 p,#uf-formula-06 span,#uf-formula-06 a{color:inherit}\n#uf-formula-06 a,#uf-formula-06 a:visited{text-decoration:none}\n\n.uff-shell{\n  max-width:1600px;\n  margin:0 auto;\n  padding:clamp(80px,9vw,145px) clamp(18px,4vw,64px);\n}\n.uff-header{\n  display:grid;\n  grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);\n  align-items:end;\n  gap:70px;\n  padding-bottom:55px;\n  border-bottom:1px solid var(--line);\n}\n.uff-kicker{\n  display:flex;align-items:center;gap:12px;\n  margin:0 0 25px;\n  color:#B76B56 !important;\n  font-size:9px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;\n}\n.uff-kicker span{\n  width:27px;height:27px;border:1px solid #B76B56;border-radius:50%;\n  display:inline-flex;align-items:center;justify-content:center;\n  color:#B76B56 !important;font-size:8px;letter-spacing:0;\n}\n.uff-title{\n  margin:0 !important;\n  color:#F5F0EC !important;\n  font-size:clamp(50px,6.7vw,105px);\n  line-height:.88;font-weight:500;letter-spacing:-.07em;text-transform:uppercase;\n}\n.uff-title em{color:#B76B56 !important;font-weight:inherit}\n.uff-intro{\n  margin:0 0 5px;\n  max-width:430px;\n  color:rgba(245,240,236,.68) !important;\n  font-size:13px;line-height:1.65;\n}\n\n/* FORMULA */\n.uff-formula{\n  display:grid;\n  grid-template-columns:1fr 60px 1fr 60px 1fr;\n  align-items:stretch;\n  margin-top:0;\n}\n.uff-card{\n  min-height:390px;\n  padding:50px 35px 42px;\n  border-bottom:1px solid var(--line);\n  display:flex;\n  flex-direction:column;\n  justify-content:space-between;\n}\n.uff-card + .uff-operator,\n.uff-operator + .uff-card{\n  border-left:1px solid var(--line);\n}\n.uff-number{\n  color:#B76B56 !important;\n  font-size:9px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;\n}\n.uff-card-main{padding:55px 0 35px}\n.uff-card h3{\n  margin:0 !important;\n  color:#F5F0EC !important;\n  font-size:clamp(32px,3vw,50px);\n  line-height:.94;font-weight:500;letter-spacing:-.05em;text-transform:uppercase;\n}\n.uff-card p{\n  max-width:330px;\n  margin:20px 0 0;\n  color:rgba(245,240,236,.62) !important;\n  font-size:12px;line-height:1.6;\n}\n.uff-card-tag{\n  color:rgba(245,240,236,.48) !important;\n  font-size:8px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;\n}\n.uff-operator{\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  border-bottom:1px solid var(--line);\n  color:#B76B56 !important;\n  font-size:34px;font-weight:300;\n}\n\n/* PAYOFF */\n.uff-payoff{\n  display:grid;\n  grid-template-columns:auto 1fr auto;\n  align-items:center;\n  gap:35px;\n  padding:42px 0 0;\n}\n.uff-equals{\n  width:54px;height:54px;border:1px solid #B76B56;border-radius:50%;\n  display:flex;align-items:center;justify-content:center;\n  color:#B76B56 !important;\n  font-size:21px;\n}\n.uff-payoff-copy{\n  margin:0;\n  color:#F5F0EC !important;\n  font-size:clamp(24px,3vw,44px);\n  line-height:1.05;font-weight:500;letter-spacing:-.04em;text-transform:uppercase;\n}\n.uff-payoff-copy em{color:#B76B56 !important;font-weight:inherit}\n.uff-link,.uff-link:visited{\n  display:inline-flex;align-items:center;gap:14px;\n  padding-bottom:7px;border-bottom:1px solid #B76B56;\n  color:#F5F0EC !important;\n  font-size:9px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;\n  white-space:nowrap;\n}\n.uff-link span{color:#B76B56 !important;font-size:18px}\n\n@media(max-width:989px){\n  .uff-header{grid-template-columns:1fr;gap:30px}\n  .uff-formula{grid-template-columns:1fr}\n  .uff-card{min-height:auto;padding:45px 20px}\n  .uff-card-main{padding:40px 0 30px}\n  .uff-operator{\n    height:60px;border-left:0!important;border-bottom:1px solid var(--line);\n    border-top:0;font-size:28px;\n  }\n  .uff-card + .uff-operator,.uff-operator + .uff-card{border-left:0}\n}\n@media(max-width:749px){\n  .uff-shell{padding:72px 18px}\n  .uff-kicker{font-size:8px;margin-bottom:21px}\n  .uff-title{font-size:clamp(47px,14.5vw,69px)}\n  .uff-intro{max-width:340px;font-size:12px;line-height:1.58}\n  .uff-card{padding:38px 5px}\n  .uff-card h3{font-size:clamp(34px,10vw,46px)}\n  .uff-card p{font-size:12px}\n  .uff-payoff{grid-template-columns:48px 1fr;gap:18px;padding-top:35px}\n  .uff-equals{width:46px;height:46px}\n  .uff-payoff-copy{font-size:clamp(25px,7.5vw,36px)}\n  .uff-link{grid-column:2;width:max-content;margin-top:8px}\n}\n</style>\n\n<section id=\"uf-formula-06\">\n  <div class=\"uff-shell\">\n\n    <div class=\"uff-header\">\n      <div>\n        <div class=\"uff-kicker\">\n          <span>06</span>\n          THE UN-FAIR FORMULA\n        </div>\n\n        <h2 class=\"uff-title\">\n          ONE PRODUCT.<br>\n          <em>THREE JOBS.</em>\n        </h2>\n      </div>\n\n      <p class=\"uff-intro\">\n        UN-FAIR sits between instant cosmetic payoff and high-performance\n        skin and hair care. The point isn't adding another step. It's making\n        every step work harder.\n      </p>\n    </div>\n\n\n    <div class=\"uff-formula\">\n\n      <div class=\"uff-card\">\n        <span class=\"uff-number\">01 / NOW</span>\n\n        <div class=\"uff-card-main\">\n          <h3>INSTANT<br>PAYOFF</h3>\n          <p>\n            The visible part. Blur, glow, definition, volume,\n            evenness and freshness when you actually need them.\n          </p>\n        </div>\n\n        <span class=\"uff-card-tag\">COSMETIC-LEVEL RESULT</span>\n      </div>\n\n\n      <div class=\"uff-operator\">+</div>\n\n\n      <div class=\"uff-card\">\n        <span class=\"uff-number\">02 / INSIDE</span>\n\n        <div class=\"uff-card-main\">\n          <h3>HIGH-PERFORMANCE<br>FORMULA</h3>\n          <p>\n            Products designed to do more than camouflage —\n            combining performance-led beauty with serious ingredients.\n          </p>\n        </div>\n\n        <span class=\"uff-card-tag\">SKIN + HAIR PERFORMANCE</span>\n      </div>\n\n\n      <div class=\"uff-operator\">+</div>\n\n\n      <div class=\"uff-card\">\n        <span class=\"uff-number\">03 / LATER</span>\n\n        <div class=\"uff-card-main\">\n          <h3>LONG-TERM<br>EDGE</h3>\n          <p>\n            Benefits built around longer-term goals such as skin quality,\n            barrier support, pigmentation, pores and hair performance.\n          </p>\n        </div>\n\n        <span class=\"uff-card-tag\">BEYOND THE FIRST IMPRESSION</span>\n      </div>\n\n    </div>\n\n\n    <div class=\"uff-payoff\">\n      <div class=\"uff-equals\">=</div>\n\n      <p class=\"uff-payoff-copy\">\n        MORE RESULTS. <em>LESS ROUTINE.</em>\n      </p>\n\n      <a class=\"uff-link\" href=\"/collections/all\">\n        SHOP THE FORMULA <span>→</span>\n      </a>\n    </div>\n\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_KM7ttJ": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\nUN-FAIR — SECTION 07: SEEN IN THE WILD\nShopify Colourblock — Custom Liquid\nEditorial social-proof / UGC placeholder section.\nReplace the image URLs later with real customer/creator content.\n{% endcomment %}\n\n<style>\n#uf-proof-07{\n  --ivory:#F5F0EC;\n  --charcoal:#1C1C1B;\n  --terra:#B76B56;\n  --line:rgba(28,28,27,.15);\n  width:100%;\n  margin:0;\n  background:#F5F0EC !important;\n  color:#1C1C1B !important;\n  overflow:hidden;\n  font-family:inherit;\n}\n#uf-proof-07 *{box-sizing:border-box}\n#uf-proof-07 h2,#uf-proof-07 h3,#uf-proof-07 p,#uf-proof-07 span,#uf-proof-07 a{color:inherit}\n#uf-proof-07 a,#uf-proof-07 a:visited{text-decoration:none}\n\n.ufp-shell{\n  max-width:1600px;\n  margin:0 auto;\n  padding:clamp(78px,9vw,140px) clamp(18px,4vw,64px);\n}\n.ufp-head{\n  display:grid;\n  grid-template-columns:minmax(0,1fr) minmax(260px,390px);\n  align-items:end;\n  gap:60px;\n  padding-bottom:45px;\n}\n.ufp-kicker{\n  display:flex;align-items:center;gap:12px;\n  margin:0 0 24px;color:#B76B56 !important;\n  font-size:9px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;\n}\n.ufp-kicker span{\n  width:27px;height:27px;border:1px solid #B76B56;border-radius:50%;\n  display:inline-flex;align-items:center;justify-content:center;\n  color:#B76B56 !important;font-size:8px;letter-spacing:0;\n}\n.ufp-title{\n  margin:0 !important;color:#1C1C1B !important;\n  font-size:clamp(49px,6.4vw,98px);line-height:.89;\n  font-weight:500;letter-spacing:-.07em;text-transform:uppercase;\n}\n.ufp-title em{color:#B76B56 !important;font-weight:inherit}\n.ufp-intro{\n  margin:0 0 5px;color:rgba(28,28,27,.62) !important;\n  font-size:13px;line-height:1.65;\n}\n\n/* MEDIA GRID */\n.ufp-grid{\n  display:grid;\n  grid-template-columns:1.18fr .82fr .82fr;\n  grid-template-rows:320px 320px;\n  gap:3px;\n  background:#F5F0EC;\n}\n.ufp-card{\n  position:relative;\n  overflow:hidden;\n  background:#ded7d2;\n}\n.ufp-card:first-child{grid-row:1/3}\n.ufp-card img{\n  display:block;width:100%;height:100%;object-fit:cover;\n  transition:transform .8s cubic-bezier(.22,.61,.36,1);\n}\n.ufp-card:hover img{transform:scale(1.035)}\n.ufp-card:after{\n  content:\"\";\n  position:absolute;inset:0;\n  background:linear-gradient(180deg,transparent 55%,rgba(28,28,27,.36));\n  pointer-events:none;\n}\n.ufp-card-meta{\n  position:absolute;z-index:2;\n  left:17px;right:17px;bottom:15px;\n  display:flex;align-items:end;justify-content:space-between;gap:15px;\n  color:#F5F0EC !important;\n}\n.ufp-card-meta span{\n  color:#F5F0EC !important;\n  font-size:8px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;\n}\n.ufp-card-meta b{\n  color:#F5F0EC !important;\n  font-size:17px;font-weight:400;\n}\n\n/* REVIEW STRIP */\n.ufp-review{\n  margin-top:3px;\n  display:grid;\n  grid-template-columns:180px minmax(0,1fr) auto;\n  align-items:center;\n  gap:40px;\n  padding:42px clamp(22px,4vw,60px);\n  background:#B76B56 !important;\n  color:#F5F0EC !important;\n}\n.ufp-stars{\n  color:#F5F0EC !important;\n  font-size:14px;letter-spacing:.15em;\n}\n.ufp-stars small{\n  display:block;margin-top:8px;\n  color:rgba(245,240,236,.72) !important;\n  font-size:7px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;\n}\n.ufp-quote{\n  margin:0 !important;\n  max-width:800px;\n  color:#F5F0EC !important;\n  font-size:clamp(22px,2.4vw,37px);\n  line-height:1.08;font-weight:500;letter-spacing:-.035em;\n}\n.ufp-link,.ufp-link:visited{\n  display:inline-flex;align-items:center;gap:12px;\n  padding-bottom:7px;border-bottom:1px solid #F5F0EC;\n  color:#F5F0EC !important;\n  font-size:8px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;\n  white-space:nowrap;\n}\n.ufp-link span{color:#F5F0EC !important;font-size:17px}\n\n@media(max-width:989px){\n  .ufp-grid{grid-template-columns:1fr 1fr;grid-template-rows:460px 300px 300px}\n  .ufp-card:first-child{grid-column:1/3;grid-row:auto}\n  .ufp-review{grid-template-columns:1fr;gap:22px}\n  .ufp-stars small{display:inline;margin:0 0 0 10px}\n  .ufp-link{width:max-content}\n}\n@media(max-width:749px){\n  .ufp-shell{padding:72px 14px}\n  .ufp-head{grid-template-columns:1fr;gap:28px;padding:0 5px 35px}\n  .ufp-kicker{font-size:8px;margin-bottom:21px}\n  .ufp-title{font-size:clamp(47px,14.5vw,68px)}\n  .ufp-intro{max-width:335px;font-size:12px;line-height:1.58}\n  .ufp-grid{grid-template-columns:1fr 1fr;grid-template-rows:410px 220px 220px;gap:2px}\n  .ufp-card:first-child{grid-column:1/3}\n  .ufp-card-meta{left:10px;right:10px;bottom:10px}\n  .ufp-card-meta span{font-size:6.5px}\n  .ufp-review{padding:35px 20px}\n  .ufp-quote{font-size:clamp(23px,7vw,32px)}\n}\n</style>\n\n<section id=\"uf-proof-07\">\n  <div class=\"ufp-shell\">\n\n    <div class=\"ufp-head\">\n      <div>\n        <div class=\"ufp-kicker\">\n          <span>07</span>\n          SEEN IN THE WILD\n        </div>\n\n        <h2 class=\"ufp-title\">\n          THE EDGE<br>\n          LOOKS <em>GOOD.</em>\n        </h2>\n      </div>\n\n      <p class=\"ufp-intro\">\n        Real routines should look effortless. This space is built for\n        customer shots, creator content and the moments UN-FAIR actually\n        shows up in.\n      </p>\n    </div>\n\n\n    <div class=\"ufp-grid\">\n\n      <div class=\"ufp-card\">\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0809/1985/5353/files/sh5.png?v=1790579517\"\n          alt=\"UN-FAIR campaign\"\n          width=\"1000\"\n          height=\"1300\"\n          loading=\"lazy\">\n        <div class=\"ufp-card-meta\">\n          <span>UN-FAIR / IN REAL LIFE</span>\n          <b>↗</b>\n        </div>\n      </div>\n\n      <div class=\"ufp-card\">\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0809/1985/5353/files/sh6.png?v=1790579884\"\n          alt=\"UN-FAIR campaign\"\n          width=\"800\"\n          height=\"800\"\n          loading=\"lazy\">\n        <div class=\"ufp-card-meta\">\n          <span>LOOK SHARPER</span>\n          <b>↗</b>\n        </div>\n      </div>\n\n      <div class=\"ufp-card\">\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0809/1985/5353/files/sh7.png?v=1790580072\"\n          alt=\"UN-FAIR campaign\"\n          width=\"800\"\n          height=\"800\"\n          loading=\"lazy\">\n        <div class=\"ufp-card-meta\">\n          <span>TRY LESS</span>\n          <b>↗</b>\n        </div>\n      </div>\n\n      <div class=\"ufp-card\">\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0809/1985/5353/files/sh8.png?v=1790580282\"\n          alt=\"UN-FAIR campaign\"\n          width=\"800\"\n          height=\"800\"\n          loading=\"lazy\">\n        <div class=\"ufp-card-meta\">\n          <span>MORE OUTPUT</span>\n          <b>↗</b>\n        </div>\n      </div>\n\n      <div class=\"ufp-card\">\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0809/1985/5353/files/sh9.png?v=1790581076\"\n          alt=\"UN-FAIR campaign\"\n          width=\"800\"\n          height=\"800\"\n          loading=\"lazy\">\n        <div class=\"ufp-card-meta\">\n          <span>THE UN-FAIR EDGE</span>\n          <b>↗</b>\n        </div>\n      </div>\n\n    </div>\n\n\n    <div class=\"ufp-review\">\n\n      <div class=\"ufp-stars\">\n        ★★★★★\n        <small>YOUR REVIEWS GO HERE</small>\n      </div>\n\n      <p class=\"ufp-quote\">\n        “Looking this put-together should probably take more effort.”\n      </p>\n\n      <a class=\"ufp-link\" href=\"/collections/all\">\n        SHOP UN-FAIR <span>→</span>\n      </a>\n\n    </div>\n\n  </div>\n</section>",
